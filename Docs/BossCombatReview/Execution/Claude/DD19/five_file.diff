+// These tests prove the typed bleed policy: the reflected record and its authoring defaults, its copy into the immutable config by the real definition compiler (synthetic path, and the production path's early
+// rejection), the shared validator with every scalar boundary and both references, and the typed, lifecycle-safe assignment of exactly seven public fields on isolated native components. They do NOT prove a
+// serialized asset value, anything seen in the Details panel, a production compile with a real skeleton, that either path names an existing, cooked or correctly typed asset, that a burst is visible or a sound
+// audible, a real buildup, proc or duel, or any wiring. No BeginPlay runs on a bleed component (the native BeginPlay loads the effect, the sound and a blood flipbook material, and the order forbids it), no
+// AddBuildup, no proc and no console variable is used; the only BeginPlay is the one of a plain fixture owner that carries no bleed component yet. The component-already-began-play guard is therefore NOT executed
+// by these tests (a begun bleed component cannot be built without loading assets): it is a source claim. The runtime state of the component (buildup, threshold in force, procs, ignored counter, last proc damage,
+// last result, loaded effect, sound and flipbook) is read through its public API and public properties and must never change.
+
+namespace
+{
+namespace BleedTests
+{
+	using FEpochPtr = TSharedPtr<const RPGCombatRegistry::FEpoch>;
+	using FConfigPtr = TSharedPtr<const FRPGParticipantConfig>;
+
+	constexpr float QuietNaN = std::numeric_limits<float>::quiet_NaN();
+	constexpr float PosInf = std::numeric_limits<float>::infinity();
+	constexpr float NegInf = -std::numeric_limits<float>::infinity();
+
+	/** Test-local game world with the set-up the earlier headless tests used; destroyed with the scope. */
+	struct FBleedTestWorld
+	{
+		UWorld* World = nullptr;
+
+		FBleedTestWorld()
+		{
+			if (!GEngine)
+			{
+				return;
+			}
+			World = UWorld::CreateWorld(EWorldType::Game, /*bInformEngineOfWorld=*/false);
+			if (World)
+			{
+				FWorldContext& Context = GEngine->CreateNewWorldContext(EWorldType::Game);
+				Context.SetCurrentWorld(World);
+				World->InitializeActorsForPlay(FURL());
+			}
+		}
+
+		~FBleedTestWorld()
+		{
+			if (World)
+			{
+				GEngine->DestroyWorldContext(World);
+				World->DestroyWorld(/*bInformEngineOfWorld=*/false);
+			}
+		}
+
+		FBleedTestWorld(const FBleedTestWorld&) = delete;
+		FBleedTestWorld& operator=(const FBleedTestWorld&) = delete;
+
+		AActor* SpawnOwner() const { return World ? World->SpawnActor<AActor>() : nullptr; }
+	};
+
+	/** A soft path built from its parts, so that deliberately malformed forms are never parsed from text (no engine log, no repair). */
+	FSoftObjectPath MakePath(const TCHAR* Package, const TCHAR* Asset, const TCHAR* Sub = TEXT(""))
+	{
+		return FSoftObjectPath(FTopLevelAssetPath(FName(Package), FName(Asset)), FString(Sub));
+	}
+
+	TSoftObjectPtr<UNiagaraSystem> EffectPtr(const FSoftObjectPath& Path) { return TSoftObjectPtr<UNiagaraSystem>(Path); }
+	TSoftObjectPtr<USoundBase> SoundPtr(const FSoftObjectPath& Path) { return TSoftObjectPtr<USoundBase>(Path); }
+
+	/** The seven configured fields, the runtime state and the loaded objects of a bleed component, with an exact comparison. All of it is public API or a public property: no reflection is needed. */
+	struct FBleedState
+	{
+		float InitialThreshold, ThresholdIncrease, ThresholdMax, HpFraction, EffectHeight;
+		FSoftObjectPath ProcEffect, ProcSound;
+		float Buildup, Threshold, LastProcDamage;
+		int32 Procs, Ignored;
+		FString LastResult;
+		bool bNothingLoaded;
+
+		explicit FBleedState(const URPGBossBleed& C)
+			: InitialThreshold(C.InitialThreshold), ThresholdIncrease(C.ThresholdIncrease), ThresholdMax(C.ThresholdMax), HpFraction(C.HpFraction), EffectHeight(C.EffectHeight)
+			, ProcEffect(C.ProcEffect.ToSoftObjectPath()), ProcSound(C.ProcSound.ToSoftObjectPath())
+			, Buildup(C.GetBuildup()), Threshold(C.GetThreshold()), LastProcDamage(C.GetLastProcDamage()), Procs(C.GetProcCount()), Ignored(C.GetIgnoredCount()), LastResult(C.GetLastResult())
+			, bNothingLoaded(C.LoadedEffect == nullptr && C.LoadedSound == nullptr && C.LoadedBloodFlipbook == nullptr)
+		{
+		}
+
+		bool ConfigEquals(const FBleedState& O) const
+		{
+			return InitialThreshold == O.InitialThreshold && ThresholdIncrease == O.ThresholdIncrease && ThresholdMax == O.ThresholdMax && HpFraction == O.HpFraction && EffectHeight == O.EffectHeight
+				&& ProcEffect == O.ProcEffect && ProcSound == O.ProcSound;
+		}
+
+		bool RuntimeEquals(const FBleedState& O) const
+		{
+			return bNothingLoaded == O.bNothingLoaded && Buildup == O.Buildup && Threshold == O.Threshold && LastProcDamage == O.LastProcDamage && Procs == O.Procs && Ignored == O.Ignored
+				&& LastResult.Equals(O.LastResult, ESearchCase::CaseSensitive);
+		}
+
+		bool operator==(const FBleedState& O) const { return ConfigEquals(O) && RuntimeEquals(O); }
+
+		/** The runtime state of a component that never began play: no buildup, the native struct default threshold (NOT seeded from InitialThreshold), no proc, nothing ignored, nothing loaded. */
+		bool IsUntouchedRuntime() const
+		{
+			return bNothingLoaded && Buildup == 0.f && Threshold == 100.f && LastProcDamage == 0.f && Procs == 0 && Ignored == 0 && LastResult == TEXT("none");
+		}
+	};
+
+	/** Record A: the zero-valid and signed boundaries (zero increase, maximum equal to the start, zero fraction, negative height). */
+	FRPGParticipantConfig ConfigA()
+	{
+		FRPGParticipantConfig C;
+		C.Bleed.InitialThreshold = 150.f;
+		C.Bleed.ThresholdIncrease = 0.f;
+		C.Bleed.ThresholdMax = 150.f;
+		C.Bleed.HpFraction = 0.f;
+		C.Bleed.EffectHeight = -35.f;
+		C.Bleed.ProcEffect = EffectPtr(MakePath(TEXT("/SyntheticMount/Bleed/A"), TEXT("NS_TestBurstA")));
+		C.Bleed.ProcSound = SoundPtr(MakePath(TEXT("/SyntheticMount/Bleed/A"), TEXT("SC_TestImpactA")));
+		return C;
+	}
+
+	/** Record B: ordinary non-default values, the fraction at its upper bound. */
+	FRPGParticipantConfig ConfigB()
+	{
+		FRPGParticipantConfig C;
+		C.Bleed.InitialThreshold = 40.5f;
+		C.Bleed.ThresholdIncrease = 7.25f;
+		C.Bleed.ThresholdMax = 333.5f;
+		C.Bleed.HpFraction = 1.f;
+		C.Bleed.EffectHeight = 12.75f;
+		C.Bleed.ProcEffect = EffectPtr(MakePath(TEXT("/SyntheticMount/Bleed/B"), TEXT("NS_TestBurstB")));
+		C.Bleed.ProcSound = SoundPtr(MakePath(TEXT("/SyntheticMount/Bleed/B"), TEXT("SC_TestImpactB")));
+		return C;
+	}
+
+	/** Record A with one change applied. */
+	FRPGParticipantConfig WithBleed(const TFunction<void(FRPGBleedConfig&)>& Change)
+	{
+		FRPGParticipantConfig C = ConfigA();
+		Change(C.Bleed);
+		return C;
+	}
+
+	/** A distinct starting state, different from both configs and from the native defaults (written through the public fields, as the native component allows). */
+	void ArmDistinctStart(URPGBossBleed& C)
+	{
+		C.InitialThreshold = 11.f;
+		C.ThresholdIncrease = 12.f;
+		C.ThresholdMax = 13.f;
+		C.HpFraction = 0.5f;
+		C.EffectHeight = 14.f;
+		C.ProcEffect = EffectPtr(MakePath(TEXT("/SyntheticMount/Start/Bleed"), TEXT("NS_StartBurst")));
+		C.ProcSound = SoundPtr(MakePath(TEXT("/SyntheticMount/Start/Bleed"), TEXT("SC_StartImpact")));
+	}
+
+	FRPGParityField MakeField(const FString& Path, const FString& ValueText)
+	{
+		FRPGParityField Field;
+		Field.FieldPath = Path;
+		Field.Type = TEXT("float");
+		Field.Value = ValueText;
+		Field.SourcePath = TEXT("synthetic fixture, not live provenance");
+		Field.SourceSHA256 = FString::ChrN(64, TEXT('a'));
+		Field.SourceSite = TEXT("fixture");
+		Field.Origin = TEXT("harness");
+		Field.Precedence = TEXT("fixture");
+		Field.Destination = TEXT("fixture");
+		Field.FirstRead = TEXT("BeginPlay");
+		Field.Witness = TEXT("synthetic only");
+		return Field;
+	}
+
+	/** A valid definition for the real synthetic compiler with the given bleed record (every other record is the authoring default or a valid fixture value). */
+	TStrongObjectPtr<URPGBossDefinition> MakeDefinition(const FRPGBleedConfig& Bleed)
+	{
+		TStrongObjectPtr<URPGBossDefinition> Definition(NewObject<URPGBossDefinition>());
+		Definition->DefinitionId = TEXT("Synthetic");
+		Definition->PresentationId = TEXT("SyntheticLook");
+		Definition->Stats.MaxHealth = 3500.f;
+		Definition->Stats.MaxPosture = 73.5f;
+		Definition->Stats.PostureRegenDelay = 4.25f;
+		Definition->Stats.PostureRegenRate = 9.75f;
+		FRPGPhaseConfig Phase;
+		Phase.PhaseId = TEXT("PhaseTwo");
+		Phase.EntryHealthFraction = 0.35f;
+		Phase.SpeedMultiplier = 1.5f;
+		Phase.RateMultiplier = 1.75f;
+		Phase.AttackMultiplier = 2.f;
+		Definition->Phases.Add(Phase);
+		Definition->Bleed = Bleed;
+		for (const FString& Path : TArray<FString>{RPGBossBleedAdapters::FieldInitialThreshold, RPGBossBleedAdapters::FieldThresholdIncrease, RPGBossBleedAdapters::FieldThresholdMax,
+			RPGBossBleedAdapters::FieldHpFraction, RPGBossBleedAdapters::FieldEffectHeight, RPGBossBleedAdapters::FieldProcEffect, RPGBossBleedAdapters::FieldProcSound})
+		{
+			Definition->Fields.Add(MakeField(Path, TEXT("synthetic")));
+		}
+		Definition->Fields.Add(MakeField(TEXT("Stats.MaxHealth"), TEXT("synthetic")));
+		return Definition;
+	}
+
+	FRPGHydrationResult CompileSynthetic(const URPGBossDefinition& Definition, FEpochPtr Content, FConfigPtr& Out, const FString& Hash = FString::ChrN(64, TEXT('b')))
+	{
+		return RPGCombatHydration::CompileSyntheticParticipant(Definition, Content, Hash, Out);
+	}
+
+	bool AnyErrorContains(const FRPGHydrationResult& Result, const TCHAR* Text)
+	{
+		return Result.Errors.ContainsByPredicate([Text](const FString& E) { return E.Contains(Text); });
+	}
+
+	/** One single error message that carries both the token and the field path. */
+	bool AnyErrorContainsBoth(const FRPGHydrationResult& Result, const TCHAR* Token, const TCHAR* FieldPath)
+	{
+		return Result.Errors.ContainsByPredicate([Token, FieldPath](const FString& E) { return E.Contains(Token) && E.Contains(FieldPath); });
+	}
+
+	TStrongObjectPtr<URPGBossBleed> NewBleed(AActor* Owner, const TCHAR* Name)
+	{
+		return TStrongObjectPtr<URPGBossBleed>(NewObject<URPGBossBleed>(Owner, Name));
+	}
+
+	bool SameRecordPaths(const FRPGBleedConfig& L, const FRPGBleedConfig& R)
+	{
+		return L.InitialThreshold == R.InitialThreshold && L.ThresholdIncrease == R.ThresholdIncrease && L.ThresholdMax == R.ThresholdMax && L.HpFraction == R.HpFraction && L.EffectHeight == R.EffectHeight
+			&& L.ProcEffect.ToSoftObjectPath() == R.ProcEffect.ToSoftObjectPath() && L.ProcSound.ToSoftObjectPath() == R.ProcSound.ToSoftObjectPath();
+	}
+}
+}
