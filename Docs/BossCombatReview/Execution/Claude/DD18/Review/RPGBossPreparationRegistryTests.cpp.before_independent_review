		/** Every actor of every encounter built so far, plus the combat context counts. */
		TArray<FActorState> CaptureAll(int32& OutBound, int32& OutReady) const
		{
			TArray<FActorState> States;
			for (const FEncounterSet& Set : Sets)
			{
				for (const AActor* Actor : Set.Actors())
				{
					States.Add(CaptureActor(Actor));
				}
			}
			OutBound = -1;
			OutReady = -1;
			if (const URPGCombatContextSubsystem* Context = Scope.World->GetSubsystem<URPGCombatContextSubsystem>())
			{
				OutBound = Context->GetBoundCount();
				OutReady = Context->GetReadyCount();
			}
			return States;
		}
	};

	bool SameStates(const TArray<FActorState>& A, const TArray<FActorState>& B, int32 BoundA, int32 ReadyA, int32 BoundB, int32 ReadyB)
	{
		if (A.Num() != B.Num() || BoundA != BoundB || ReadyA != ReadyB)
		{
			return false;
		}
		for (int32 Index = 0; Index < A.Num(); ++Index)
		{
			if (A[Index].bBegun != B[Index].bBegun || A[Index].Components != B[Index].Components || A[Index].Flags != B[Index].Flags)
			{
				return false;
			}
		}
		return true;
	}

	/** The actors of every encounter built so far and the combat context are exactly as in the given capture (the new capture is taken inside, so no argument depends on the evaluation order of another). */
	bool Matches(const FMultiFixture& F, const TArray<FActorState>& States, int32 Bound, int32 Ready)
	{
		int32 NowBound = -1;
		int32 NowReady = -1;
		const TArray<FActorState> Now = F.CaptureAll(NowBound, NowReady);
		return SameStates(States, Now, Bound, Ready, NowBound, NowReady);
	}

	/** The five consumers of both bosses, none on the target, all unregistered, uninitialized, not begun and unticked. */
	bool IsFullyPrepared(const FEncounterSet& Set)
	{
		for (const AActor* Boss : {static_cast<const AActor*>(Set.BossOne), static_cast<const AActor*>(Set.BossTwo)})
		{
			for (const FExpectedComponent& Wanted : ExpectedComponents())
			{
				const UActorComponent* Component = Boss->FindComponentByClass(Wanted.Class);
				if (!Component || Component->GetFName() != FName(Wanted.Name) || Component->GetOwner() != Boss || Component->IsRegistered() || Component->HasBegunPlay() || Component->HasBeenInitialized()
					|| Component->PrimaryComponentTick.IsTickFunctionRegistered())
				{
					return false;
				}
			}
		}
		return NoManagedConsumer(Set.Target);
	}

	bool HasNoConsumers(const FEncounterSet& Set) { return NoManagedConsumer(Set.BossOne) && NoManagedConsumer(Set.BossTwo) && NoManagedConsumer(Set.Target); }

	/** No object, not even a destroyed one, carries a planned name under any actor of the set: nothing was allocated. */
	bool NothingAllocated(const FEncounterSet& Set)
	{
		for (const AActor* Actor : Set.Actors())
		{
			for (const FExpectedComponent& Wanted : ExpectedComponents())
			{
				if (StaticFindObjectFast(UObject::StaticClass(), const_cast<AActor*>(Actor), FName(Wanted.Name)) != nullptr)
				{
					return false;
				}
			}
		}
		return true;
	}

	/** The markers are still the same live unregistered objects. */
	bool MarkersIntact(const FEncounterSet& Set)
	{
		return Set.Markers[0] && Set.Markers[1] && Set.Markers[2] && IsValid(Set.Markers[0]) && IsValid(Set.Markers[1]) && IsValid(Set.Markers[2]) && !Set.Markers[0]->IsRegistered() && !Set.Markers[1]->IsRegistered()
			&& !Set.Markers[2]->IsRegistered();
	}

	/** A refused reservation: not succeeded, no held token, the failure family, ONE error with the token and where text, nothing changed anywhere. */
	bool ExpectRefused(FAutomationTestBase& Test, const FMultiFixture& F, FRPGBossPreparationRegistry& Registry, const TCHAR* Label, const ARPGEncounterBinding* Binding, EReservationFailure Failure, const TCHAR* Token, const TCHAR* Where)
	{
		int32 BoundBefore, ReadyBefore;
		const TArray<FActorState> Before = F.CaptureAll(BoundBefore, ReadyBefore);
		const int32 ActiveBefore = Registry.GetActiveReservationCount();
		const TArray<FGuid> ReservedBefore = Registry.GetReservedEncounters();
		const FRPGReservationResult Result = Registry.TryPrepareAndReserve(Binding, F.MakeSelections(), ManifestHash());
		bool bOk = Test.TestFalse(FString::Printf(TEXT("%s: refused, no held token"), Label), Result.Succeeded() || Result.Token.IsHeld());
		bOk &= Test.TestTrue(FString::Printf(TEXT("%s: the failure family is the expected one"), Label), Result.Failure == Failure);
		bOk &= Test.TestTrue(FString::Printf(TEXT("%s: ONE error carries %s and %s (got: %s)"), Label, Token, Where, *JoinErrors(Result.Errors)), AnyErrorHasAll(Result.Errors, Token, Where, TEXT("")));
		int32 BoundAfter, ReadyAfter;
		const TArray<FActorState> After = F.CaptureAll(BoundAfter, ReadyAfter);
		bOk &= Test.TestTrue(FString::Printf(TEXT("%s: every actor of every encounter, every component set and the combat context are exactly as before"), Label), SameStates(Before, After, BoundBefore, ReadyBefore, BoundAfter, ReadyAfter));
		bOk &= Test.TestTrue(FString::Printf(TEXT("%s: the registry is unchanged: same active count and same reserved encounters in the same order"), Label), Registry.GetActiveReservationCount() == ActiveBefore && Registry.GetReservedEncounters() == ReservedBefore);
		return bOk;
	}
}
}

