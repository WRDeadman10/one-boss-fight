IMPLEMENT_SIMPLE_AUTOMATION_TEST(FRPGPreparationRegistryAdmissionTest, "OneBossFight.Binding.PreparationRegistry.AdmissionAndConflicts",
	EAutomationTestFlags::EditorContext | EAutomationTestFlags::ProductFilter)
bool FRPGPreparationRegistryAdmissionTest::RunTest(const FString& Parameters)
{
	FMultiFixture F;
	if (!F.Load(*this))
	{
		return false;
	}
	FEncounterSet* A = F.AddSet(*this, 0);
	FEncounterSet* B = F.AddSet(*this, 1);
	if (!A || !B)
	{
		return false;
	}
	FRPGBossPreparationRegistry Registry(F.Scope.World);
	TestTrue(TEXT("a new registry is open, empty and has its own identity"), !Registry.IsAdmissionClosed() && Registry.GetActiveReservationCount() == 0 && Registry.GetQuarantinedCount() == 0 && Registry.GetRegistryId().IsValid());

	// Two disjoint encounters coexist; the slot strings are identical across them (legal); each batch is two bosses and a target.
	FRPGReservationResult ResultA = Registry.TryPrepareAndReserve(A->Binding, F.MakeSelections(), ManifestHash());
	if (!TestTrue(FString::Printf(TEXT("encounter A is prepared and reserved (errors: %s)"), *JoinErrors(ResultA.Errors)), ResultA.Succeeded()))
	{
		return false;
	}
	FRPGReservationResult ResultB = Registry.TryPrepareAndReserve(B->Binding, F.MakeSelections(), ManifestHash());
	if (!TestTrue(FString::Printf(TEXT("the disjoint encounter B is prepared and reserved too (errors: %s)"), *JoinErrors(ResultB.Errors)), ResultB.Succeeded()))
	{
		return false;
	}
	TestTrue(TEXT("the two encounters use identical slot strings"), A->Binding->Participants[0].Slot == B->Binding->Participants[0].Slot && A->Binding->Participants[1].Slot == B->Binding->Participants[1].Slot
		&& A->Binding->Participants[2].Slot == B->Binding->Participants[2].Slot && A->Binding->Participants[0].Slot == FName(TEXT("BossOne")));
	TestTrue(TEXT("two active reservations, no quarantine, both GUIDs reserved in admission order"), Registry.GetActiveReservationCount() == 2 && Registry.GetQuarantinedCount() == 0 && Registry.GetReservedEncounters() == TArray<FGuid>{A->Encounter, B->Encounter});
	TestTrue(TEXT("the tokens carry the registry identity, distinct serials and their own encounter GUIDs, and are held"), ResultA.Token.IsHeld() && ResultB.Token.IsHeld() && ResultA.Token.GetRegistryId() == Registry.GetRegistryId()
		&& ResultB.Token.GetRegistryId() == Registry.GetRegistryId() && ResultA.Token.GetSerial() != ResultB.Token.GetSerial() && ResultA.Token.GetSerial() != 0 && ResultB.Token.GetSerial() != 0
		&& ResultA.Token.GetEncounter() == A->Encounter && ResultB.Token.GetEncounter() == B->Encounter);
	TestTrue(TEXT("both encounters hold ten unregistered components each (five per boss, none on the target) and the unrelated markers are untouched"), IsFullyPrepared(*A) && IsFullyPrepared(*B) && MarkersIntact(*A) && MarkersIntact(*B));

	// A duplicate encounter GUID with fully disjoint actors: refused before anything is allocated for the new actors.
	FEncounterSet* C = F.AddSet(*this, 2);
	FEncounterSet* D = F.AddSet(*this, 3);
	FEncounterSet* E = F.AddSet(*this, 4);
	FEncounterSet* G = F.AddSet(*this, 5);
	if (!C || !D || !E || !G)
	{
		return false;
	}
	C->Binding->EncounterInstance = A->Encounter;
	ExpectRefused(*this, F, Registry, TEXT("a duplicate encounter GUID with disjoint actors"), C->Binding, EReservationFailure::Conflict, TEXT("Reservation.DuplicateEncounter"), TEXT("[encounter="));
	TestTrue(TEXT("a duplicate GUID: the disjoint actors of the refused encounter hold no consumer and no allocated name"), HasNoConsumers(*C) && NothingAllocated(*C));

	// Overlap of a TARGET-ONLY actor: encounter D's third member is encounter A's target actor.
	{
		TArray<FRPGPlacedParticipantBinding> Overlap = F.MakeParticipants(*D);
		Overlap[2].Actor = A->Target;
		Overlap[2].Definition = A->Definitions[2].Get();
		ARPGEncounterBinding* Case = F.SpawnBinding(Overlap, FGuid::NewGuid());
		if (TestNotNull(TEXT("a binding overlapping a reserved target actor was spawned"), Case))
		{
			ExpectRefused(*this, F, Registry, TEXT("a target-only actor overlap"), Case, EReservationFailure::Conflict, TEXT("Reservation.ActorConflict"), TEXT("[slot=Player]"));
			TestTrue(TEXT("a target overlap: the other actors of the refused encounter hold no consumer and no allocated name"), NoManagedConsumer(D->BossOne) && NoManagedConsumer(D->BossTwo) && NothingAllocated(*D));
		}
	}
	// Overlap of a BOSS actor: encounter E's second member is encounter B's first boss.
	{
		TArray<FRPGPlacedParticipantBinding> Overlap = F.MakeParticipants(*E);
		Overlap[1].Actor = B->BossOne;
		Overlap[1].Definition = B->Definitions[0].Get();
		ARPGEncounterBinding* Case = F.SpawnBinding(Overlap, FGuid::NewGuid());
		if (TestNotNull(TEXT("a binding overlapping a reserved boss actor was spawned"), Case))
		{
			ExpectRefused(*this, F, Registry, TEXT("a boss actor overlap"), Case, EReservationFailure::Conflict, TEXT("Reservation.ActorConflict"), TEXT("[slot=BossTwo]"));
			TestTrue(TEXT("a boss overlap: the other actors of the refused encounter hold no consumer and no allocated name"), NoManagedConsumer(E->BossOne) && NoManagedConsumer(E->Target));
		}
	}

	// A failed LATE preparation (a real name collision under the later owner) preserves every earlier reservation and publishes nothing.
	const FExpectedComponent EncounterComponent = ExpectedComponents()[2];
	USceneComponent* Blocker = NewObject<USceneComponent>(G->BossTwo, USceneComponent::StaticClass(), FName(EncounterComponent.Name));
	if (!TestNotNull(TEXT("the blocker was created under the later owner of encounter G"), Blocker))
	{
		return false;
	}
	TStrongObjectPtr<USceneComponent> BlockerLease(Blocker);
	{
		int32 BoundBefore, ReadyBefore;
		const TArray<FActorState> Before = F.CaptureAll(BoundBefore, ReadyBefore);
		const FRPGReservationResult Refused = Registry.TryPrepareAndReserve(G->Binding, F.MakeSelections(), ManifestHash());
		TestFalse(TEXT("late failure: refused, no held token"), Refused.Succeeded() || Refused.Token.IsHeld());
		TestTrue(TEXT("late failure: the preparation family"), Refused.Failure == EReservationFailure::PreparationFailed);
		TestTrue(FString::Printf(TEXT("late failure: ONE error, the real allocation guard with the slot and the component (got: %s)"), *JoinErrors(Refused.Errors)),
			Refused.Errors.Num() == 1 && AnyErrorHasAll(Refused.Errors, TEXT("Preparation.AllocationFailed"), TEXT("[slot=BossTwo]"), TEXT("[component=RPGBossEncounter]")));
		int32 BoundAfter, ReadyAfter;
		const TArray<FActorState> After = F.CaptureAll(BoundAfter, ReadyAfter);
		TestTrue(TEXT("late failure: encounters A and B are exactly as they were (their components are the same objects) and the registry still holds exactly them"),
			Registry.GetActiveReservationCount() == 2 && Registry.GetReservedEncounters() == TArray<FGuid>{A->Encounter, B->Encounter} && IsFullyPrepared(*A) && IsFullyPrepared(*B));
		// Encounter G: the earlier allocations were cleaned (destroyed objects), the blocker is the very live object, nothing is reserved for it.
		bool bGDestroyed = true;
		for (const FExpectedComponent& Wanted : ExpectedComponents())
		{
			const UObject* Found = StaticFindObjectFast(UObject::StaticClass(), G->BossOne, FName(Wanted.Name));
			bGDestroyed = bGDestroyed && Found && !IsValid(Found);
		}
		TestTrue(TEXT("late failure: encounter G's earlier allocations were cleaned (destroyed), the blocked name is the very live blocker and G holds no live consumer"), bGDestroyed && IsValid(Blocker)
			&& StaticFindObjectFast(UObject::StaticClass(), G->BossTwo, FName(EncounterComponent.Name)) == Blocker && NoManagedConsumer(G->BossOne) && NoManagedConsumer(G->BossTwo) && NoManagedConsumer(G->Target));
		// Everything except G's cleaned allocations is as before: compare the actor sets of A..F (G's actors may differ only by the destroyed objects, which are not owned components any more).
		TestTrue(TEXT("late failure: every actor of every encounter has the same component set and flags as before"), SameStates(Before, After, BoundBefore, ReadyBefore, BoundAfter, ReadyAfter));
	}
	// Remove ONLY the fixture-owned blocker (renamed away first, as in the world preparation tests) and encounter G is admitted: nothing provisional was left by the failure.
	{
		const FName RemovedName = MakeUniqueObjectName(G->BossTwo, USceneComponent::StaticClass(), TEXT("DD18RemovedBlocker"));
		Blocker->Rename(*RemovedName.ToString(), G->BossTwo, REN_DontCreateRedirectors | REN_NonTransactional);
		Blocker->DestroyComponent();
		BlockerLease.Reset();
		Blocker = nullptr;
		FRPGReservationResult ResultG = Registry.TryPrepareAndReserve(G->Binding, F.MakeSelections(), ManifestHash());
		TestTrue(FString::Printf(TEXT("after only the blocker was removed encounter G is admitted (errors: %s)"), *JoinErrors(ResultG.Errors)), ResultG.Succeeded() && IsFullyPrepared(*G));
		TestTrue(TEXT("three active reservations in admission order A, B, G"), Registry.GetActiveReservationCount() == 3 && Registry.GetReservedEncounters() == TArray<FGuid>{A->Encounter, B->Encounter, G->Encounter});
		TestTrue(TEXT("encounters A and B were never disturbed by any refused or later admission"), IsFullyPrepared(*A) && IsFullyPrepared(*B) && ResultA.Token.IsHeld() && ResultB.Token.IsHeld());
	}

	AddInfo(TEXT("Admission on a real game-instance world: two disjoint encounters coexist with identical slot strings; a duplicate GUID, a target-only overlap and a boss overlap are refused before any allocation; a failed late preparation (real name collision) leaves the "
		"reservations intact and publishes nothing. NOT covered: quarantine, drift and re-entry (source-checked only), a global uniqueness claim across registries."));
	return true;
}

IMPLEMENT_SIMPLE_AUTOMATION_TEST(FRPGPreparationRegistryReleaseTest, "OneBossFight.Binding.PreparationRegistry.ReleaseAndTokens",
	EAutomationTestFlags::EditorContext | EAutomationTestFlags::ProductFilter)
bool FRPGPreparationRegistryReleaseTest::RunTest(const FString& Parameters)
{
	FMultiFixture F;
	if (!F.Load(*this))
	{
		return false;
	}
	FEncounterSet* A = F.AddSet(*this, 0);
	if (!A)
	{
		return false;
	}
	FRPGBossPreparationRegistry Registry(F.Scope.World);
	int32 BoundStart = -1;
	int32 ReadyStart = -1;
	const TArray<FActorState> Start = F.CaptureAll(BoundStart, ReadyStart);

	FRPGReservationResult First = Registry.TryPrepareAndReserve(A->Binding, F.MakeSelections(), ManifestHash());
	if (!TestTrue(FString::Printf(TEXT("encounter A is reserved (errors: %s)"), *JoinErrors(First.Errors)), First.Succeeded()))
	{
		return false;
	}
	FRPGPreparationLeaseToken TokenOne = MoveTemp(First.Token);
	const uint64 SerialOne = TokenOne.GetSerial();
	TestTrue(TEXT("the first token is held, has a serial and the encounter's GUID"), TokenOne.IsHeld() && SerialOne != 0 && TokenOne.GetEncounter() == A->Encounter && !First.Token.IsHeld());

	// A clean release frees the GUID and the actors, restores the actors exactly and consumes the token.
	const FRPGReleaseReport Released = Registry.Release(TokenOne);
	TestTrue(FString::Printf(TEXT("clean release: Released, ten destroyed, no violation (errors: %s)"), *JoinErrors(Released.Errors)), Released.IsReleased() && Released.Abort.IsClean() && Released.Abort.Destroyed == 10 && Released.Abort.ContractViolations == 0);
	TestTrue(TEXT("after the release the actors are exactly as at the start, the registry is empty and the token is consumed"), Matches(F, Start, BoundStart, ReadyStart)
		&& Registry.GetActiveReservationCount() == 0 && Registry.GetReservedEncounters().IsEmpty() && !TokenOne.IsHeld() && TokenOne.GetSerial() == 0 && HasNoConsumers(*A) && MarkersIntact(*A));

	// The same actors and GUID are admitted again with a NEW serial.
	FRPGReservationResult Again = Registry.TryPrepareAndReserve(A->Binding, F.MakeSelections(), ManifestHash());
	if (!TestTrue(FString::Printf(TEXT("the same actors and GUID are admitted again after the clean release (errors: %s)"), *JoinErrors(Again.Errors)), Again.Succeeded()))
	{
		return false;
	}
	FRPGPreparationLeaseToken TokenTwo = MoveTemp(Again.Token);
	const uint64 SerialTwo = TokenTwo.GetSerial();
	TestTrue(TEXT("the replacement has a NEW, larger serial, the same GUID and is fully prepared"), SerialTwo > SerialOne && TokenTwo.GetEncounter() == A->Encounter && TokenTwo.IsHeld() && IsFullyPrepared(*A) && Registry.GetActiveReservationCount() == 1);

	// A repeated release with the consumed token cannot touch the replacement.
	{
		const FRPGReleaseReport Repeated = Registry.Release(TokenOne);
		TestTrue(FString::Printf(TEXT("repeated release of the consumed token: Stale, nothing touched (got: %s)"), *JoinErrors(Repeated.Errors)), Repeated.Outcome == FRelease::Stale);
		TestTrue(TEXT("the replacement is intact after the repeated release"), TokenTwo.IsHeld() && IsFullyPrepared(*A) && Registry.GetActiveReservationCount() == 1);
	}
	// Validation is by registry identity AND serial, never by GUID alone: a forged token with the OLD serial and the very same registry and GUID, and one with the NEW serial and a wrong GUID, release nothing.
	{
		FRPGPreparationLeaseToken OldSerial = FRPGPreparationLeaseToken::ForgeForTest(Registry, SerialOne, A->Encounter);
		TestTrue(TEXT("the forged token carries the same registry identity, the same GUID and the OLD serial, and is not held"), !OldSerial.IsHeld() && OldSerial.GetEncounter() == A->Encounter && OldSerial.GetRegistryId() == Registry.GetRegistryId());
		const FRPGReleaseReport ByRegistry = Registry.Release(OldSerial);
		TestTrue(FString::Printf(TEXT("old-serial forged token released through the registry: Stale (got: %s)"), *JoinErrors(ByRegistry.Errors)), ByRegistry.Outcome == FRelease::Stale);
		const FRPGReleaseReport ByToken = OldSerial.Release();
		TestTrue(TEXT("the same token released through itself: Stale"), ByToken.Outcome == FRelease::Stale);
		FRPGPreparationLeaseToken WrongGuid = FRPGPreparationLeaseToken::ForgeForTest(Registry, SerialTwo, FGuid::NewGuid());
		const FRPGReleaseReport WrongGuidReport = Registry.Release(WrongGuid);
		TestTrue(FString::Printf(TEXT("new-serial token with a wrong GUID: Stale (got: %s)"), *JoinErrors(WrongGuidReport.Errors)), WrongGuidReport.Outcome == FRelease::Stale && !WrongGuid.IsHeld());
		TestTrue(TEXT("the replacement is still reserved and prepared after every forged release (the forged tokens' destruction below releases nothing either)"), TokenTwo.IsHeld() && IsFullyPrepared(*A) && Registry.GetActiveReservationCount() == 1);
	}
	TestTrue(TEXT("the forged tokens were destroyed: the replacement is still reserved and prepared"), TokenTwo.IsHeld() && IsFullyPrepared(*A) && Registry.GetActiveReservationCount() == 1);

	// A token of ANOTHER registry (same world) cannot release it, and the token is left as it was.
	{
		FRPGBossPreparationRegistry Other(F.Scope.World);
		const FRPGReleaseReport WrongRegistry = Other.Release(TokenTwo);
		TestTrue(FString::Printf(TEXT("a token released through another registry: WrongRegistry (got: %s)"), *JoinErrors(WrongRegistry.Errors)), WrongRegistry.Outcome == FRelease::WrongRegistry);
		TestTrue(TEXT("the token is unchanged and the reservation is intact"), TokenTwo.IsHeld() && TokenTwo.GetSerial() == SerialTwo && IsFullyPrepared(*A) && Registry.GetActiveReservationCount() == 1 && Other.GetActiveReservationCount() == 0);
		FRPGPreparationLeaseToken ForgedOfOther = FRPGPreparationLeaseToken::ForgeForTest(Other, SerialTwo, A->Encounter);
		TestTrue(TEXT("a token forged with the OTHER registry's identity, the same serial and GUID is WrongRegistry for the first registry (its own destruction releases nothing: the other registry holds nothing)"),
			Registry.Release(ForgedOfOther).Outcome == FRelease::WrongRegistry && TokenTwo.IsHeld() && IsFullyPrepared(*A));
		TestTrue(TEXT("the other registry also admits nothing it does not own: the same actors are refused by the PREFLIGHT there (the consumers exist) and the first reservation is intact"),
			!Other.TryPrepareAndReserve(A->Binding, F.MakeSelections(), ManifestHash()).Succeeded() && TokenTwo.IsHeld() && IsFullyPrepared(*A));
	}
	// The token releases through itself.
	const FRPGReleaseReport ByOwnToken = TokenTwo.Release();
	TestTrue(FString::Printf(TEXT("the token releases through its own registry: Released, ten destroyed (errors: %s)"), *JoinErrors(ByOwnToken.Errors)), ByOwnToken.IsReleased() && ByOwnToken.Abort.Destroyed == 10 && !TokenTwo.IsHeld());
	TestTrue(TEXT("the registry is empty and the actors are exactly as at the start"), Registry.GetActiveReservationCount() == 0 && Matches(F, Start, BoundStart, ReadyStart) && HasNoConsumers(*A));

	AddInfo(TEXT("Release on a real game-instance world: a clean release frees the GUID and the actors, re-admission gets a new larger serial, and a consumed, forged-serial (same registry and GUID), forged-GUID or wrong-registry token releases nothing and never "
		"harms the replacement. NOT covered: a release whose cleanup is not clean (quarantine: source-checked only), drift, re-entry."));
	return true;
}

IMPLEMENT_SIMPLE_AUTOMATION_TEST(FRPGPreparationRegistryLifetimeTest, "OneBossFight.Binding.PreparationRegistry.Lifetime",
	EAutomationTestFlags::EditorContext | EAutomationTestFlags::ProductFilter)
bool FRPGPreparationRegistryLifetimeTest::RunTest(const FString& Parameters)
{
	// The world-dies-first case is built FIRST: its registry and token are declared before the fixture they live in, so the fixture (the world) is destroyed before them.
	TUniquePtr<FRPGBossPreparationRegistry> OuterRegistry;
	FRPGPreparationLeaseToken OuterToken;
	{
		FMultiFixture W;
		if (!W.Load(*this))
		{
			return false;
		}
		FEncounterSet* Set = W.AddSet(*this, 0);
		if (!Set)
		{
			return false;
		}
		OuterRegistry = MakeUnique<FRPGBossPreparationRegistry>(W.Scope.World);
		FRPGReservationResult Reserved = OuterRegistry->TryPrepareAndReserve(Set->Binding, W.MakeSelections(), ManifestHash());
		if (!TestTrue(FString::Printf(TEXT("the world-dies-first encounter is reserved (errors: %s)"), *JoinErrors(Reserved.Errors)), Reserved.Succeeded()))
		{
			return false;
		}
		OuterToken = MoveTemp(Reserved.Token);
	} // the fixture, its actors, its game instance and its world are gone here
	TestTrue(TEXT("world dies first: the registry still lists the reservation and the token is still held (nothing was dereferenced when the world went away)"), OuterToken.IsHeld() && OuterRegistry->GetActiveReservationCount() == 1);
	{
		const FRPGReleaseReport Report = OuterRegistry->Release(OuterToken);
		AddInfo(FString::Printf(TEXT("world torn down first: release outcome %d, destroyed %d, already gone %d, violations %d (split logged, not assumed)"), static_cast<int32>(Report.Outcome), Report.Abort.Destroyed, Report.Abort.AlreadyGone, Report.Abort.ContractViolations));
		TestTrue(FString::Printf(TEXT("world dies first: the release is clean without a crash (errors: %s)"), *JoinErrors(Report.Errors)), Report.IsReleased() && Report.Abort.ContractViolations == 0);
		TestTrue(TEXT("world dies first: the registry is empty and the token is consumed"), OuterRegistry->GetActiveReservationCount() == 0 && !OuterToken.IsHeld());
		const FRPGReservationResult Refused = OuterRegistry->TryPrepareAndReserve(nullptr, TArray<FSelection>(), ManifestHash());
		TestTrue(TEXT("world dies first: a later admission through that registry is refused as invalid input (the world is gone)"), !Refused.Succeeded() && Refused.Failure == EReservationFailure::InvalidInput);
	}

	FMultiFixture F;
	if (!F.Load(*this))
	{
		return false;
	}
	FEncounterSet* A = F.AddSet(*this, 1);
	FEncounterSet* B = F.AddSet(*this, 2);
	FEncounterSet* C = F.AddSet(*this, 3);
	if (!A || !B || !C)
	{
		return false;
	}
	int32 BoundStart = -1;
	int32 ReadyStart = -1;
	const TArray<FActorState> Start = F.CaptureAll(BoundStart, ReadyStart);

	// The lease dies first: destroying the token on the game thread releases the reservation.
	{
		FRPGBossPreparationRegistry Registry(F.Scope.World);
		{
			FRPGReservationResult Reserved = Registry.TryPrepareAndReserve(A->Binding, F.MakeSelections(), ManifestHash());
			if (!TestTrue(FString::Printf(TEXT("lease dies first: encounter A is reserved (errors: %s)"), *JoinErrors(Reserved.Errors)), Reserved.Succeeded()))
			{
				return false;
			}
			FRPGPreparationLeaseToken Token = MoveTemp(Reserved.Token);
			TestTrue(TEXT("lease dies first: held, prepared, one reservation"), Token.IsHeld() && IsFullyPrepared(*A) && Registry.GetActiveReservationCount() == 1);
		} // the token is destroyed here
		TestTrue(TEXT("lease dies first: the reservation was released: empty registry, the actors exactly as at the start, GUID and actors free"), Registry.GetActiveReservationCount() == 0 && Registry.GetReservedEncounters().IsEmpty()
			&& Matches(F, Start, BoundStart, ReadyStart) && HasNoConsumers(*A));
		TestTrue(TEXT("lease dies first: the same encounter is admitted again"), [&]() { FRPGReservationResult Re = Registry.TryPrepareAndReserve(A->Binding, F.MakeSelections(), ManifestHash()); return Re.Succeeded() && IsFullyPrepared(*A); }());
	}
	TestTrue(TEXT("the registry went out of scope with a held token released by its own destruction: the actors are exactly as at the start"), Matches(F, Start, BoundStart, ReadyStart) && HasNoConsumers(*A));

	// The registry dies first: the artifacts are cleaned once, the surviving token is invalid and every later use is a safe no-op.
	FRPGPreparationLeaseToken Survivor;
	{
		FRPGBossPreparationRegistry Short(F.Scope.World);
		FRPGReservationResult Reserved = Short.TryPrepareAndReserve(B->Binding, F.MakeSelections(), ManifestHash());
		if (!TestTrue(FString::Printf(TEXT("registry dies first: encounter B is reserved (errors: %s)"), *JoinErrors(Reserved.Errors)), Reserved.Succeeded()))
		{
			return false;
		}
		Survivor = MoveTemp(Reserved.Token);
		TestTrue(TEXT("registry dies first: the token is held and B is prepared"), Survivor.IsHeld() && IsFullyPrepared(*B));
	} // the registry is destroyed here, the token survives
	TestTrue(TEXT("registry dies first: B's components were cleaned once and the surviving token is no longer held"), !Survivor.IsHeld() && HasNoConsumers(*B) && MarkersIntact(*B) && Survivor.GetSerial() != 0);
	{
		const FRPGReleaseReport ByToken = Survivor.Release();
		TestTrue(FString::Printf(TEXT("registry dies first: releasing the surviving token is a Stale no-op (got: %s)"), *JoinErrors(ByToken.Errors)), ByToken.Outcome == FRelease::Stale);
		FRPGBossPreparationRegistry Fresh(F.Scope.World);
		FRPGPreparationLeaseToken Forged = FRPGPreparationLeaseToken::ForgeForTest(Fresh, 99, B->Encounter);
		TestTrue(TEXT("a surviving token cannot release anything in a NEW registry, and the new registry admits B afresh with its own identity"), Fresh.Release(Survivor).Outcome == FRelease::Stale && Fresh.GetRegistryId() != Survivor.GetRegistryId()
			&& Fresh.Release(Forged).Outcome == FRelease::Stale && Fresh.TryPrepareAndReserve(B->Binding, F.MakeSelections(), ManifestHash()).Succeeded());
	}
	TestTrue(TEXT("after the fresh registry also went out of scope the actors are exactly as at the start"), Matches(F, Start, BoundStart, ReadyStart) && HasNoConsumers(*B));

	// The actors die first: destroying the owners of a reservation, then releasing it, never dereferences a stale identity.
	{
		FRPGBossPreparationRegistry Registry(F.Scope.World);
		FRPGReservationResult Reserved = Registry.TryPrepareAndReserve(C->Binding, F.MakeSelections(), ManifestHash());
		if (!TestTrue(FString::Printf(TEXT("actors die first: encounter C is reserved (errors: %s)"), *JoinErrors(Reserved.Errors)), Reserved.Succeeded()))
		{
			return false;
		}
		FRPGPreparationLeaseToken Token = MoveTemp(Reserved.Token);
		C->BossOne->Destroy();
		C->BossTwo->Destroy();
		C->Target->Destroy();
		TestTrue(TEXT("actors die first: the reservation still lists and the token is still held (the registry never dereferences a stale actor)"), Token.IsHeld() && Registry.GetActiveReservationCount() == 1);
		const FRPGReleaseReport Report = Registry.Release(Token);
		AddInfo(FString::Printf(TEXT("owners destroyed first: release outcome %d, destroyed %d, already gone %d, violations %d (split logged, not assumed)"), static_cast<int32>(Report.Outcome), Report.Abort.Destroyed, Report.Abort.AlreadyGone, Report.Abort.ContractViolations));
		TestTrue(FString::Printf(TEXT("actors die first: the release is clean without a crash (errors: %s)"), *JoinErrors(Report.Errors)), Report.IsReleased() && Report.Abort.ContractViolations == 0 && Registry.GetActiveReservationCount() == 0 && !Token.IsHeld());
	}

	// Off the game thread: admission and release are refused without touching anything; the token and the registry are unchanged. (Destroying a held token or the registry off the game thread is NOT run: an unsafe experiment.)
	{
		FEncounterSet* D = F.AddSet(*this, 4);
		if (!D)
		{
			return false;
		}
		FRPGBossPreparationRegistry Registry(F.Scope.World);
		FRPGReservationResult Reserved = Registry.TryPrepareAndReserve(D->Binding, F.MakeSelections(), ManifestHash());
		if (!TestTrue(FString::Printf(TEXT("off-thread case: encounter D is reserved (errors: %s)"), *JoinErrors(Reserved.Errors)), Reserved.Succeeded()))
		{
			return false;
		}
		FRPGPreparationLeaseToken Token = MoveTemp(Reserved.Token);
		const ARPGEncounterBinding* PoolBinding = D->Binding;
		const TArray<FSelection> PoolSelections = F.MakeSelections();
		const FString PoolHash = ManifestHash();
		FRPGBossPreparationRegistry* PoolRegistry = &Registry;
		FRPGPreparationLeaseToken* PoolToken = &Token;
		TFuture<TPair<EReservationFailure, TArray<FString>>> AdmitFuture = Async(EAsyncExecution::ThreadPool, [PoolRegistry, PoolBinding, &PoolSelections, &PoolHash]()
			{
				FRPGReservationResult Result = PoolRegistry->TryPrepareAndReserve(PoolBinding, PoolSelections, PoolHash);
				return TPair<EReservationFailure, TArray<FString>>(Result.Failure, Result.Errors);
			});
		const TPair<EReservationFailure, TArray<FString>> Admitted = AdmitFuture.Get();
		TestTrue(FString::Printf(TEXT("off-thread admission: refused as a contract violation without touching anything (got: %s)"), *JoinErrors(Admitted.Value)),
			Admitted.Key == EReservationFailure::ContractViolation && AnyErrorHasAll(Admitted.Value, TEXT("Reservation.NotGameThread"), TEXT(""), TEXT("nothing was touched")));
		TFuture<TPair<FRelease, TArray<FString>>> ReleaseFuture = Async(EAsyncExecution::ThreadPool, [PoolRegistry, PoolToken]()
			{
				const FRPGReleaseReport Report = PoolRegistry->Release(*PoolToken);
				return TPair<FRelease, TArray<FString>>(Report.Outcome, Report.Errors);
			});
		const TPair<FRelease, TArray<FString>> OffRelease = ReleaseFuture.Get();
		TestTrue(FString::Printf(TEXT("off-thread release through the registry: Refused (got: %s)"), *JoinErrors(OffRelease.Value)), OffRelease.Key == FRelease::Refused);
		TFuture<FRelease> TokenReleaseFuture = Async(EAsyncExecution::ThreadPool, [PoolToken]() { return PoolToken->Release().Outcome; });
		TestTrue(TEXT("off-thread release through the token: Refused"), TokenReleaseFuture.Get() == FRelease::Refused);
		TestTrue(TEXT("after the off-thread refusals the token is still held, the reservation and its ten components are intact and the registry is unchanged"), Token.IsHeld() && IsFullyPrepared(*D) && Registry.GetActiveReservationCount() == 1
			&& Registry.GetReservedEncounters() == TArray<FGuid>{D->Encounter});
	}

	AddInfo(TEXT("Lifetime orders on a real game-instance world: the world torn down first, the lease first, the registry first (surviving token invalid, no cross-registry effect), the owners destroyed first, and the off-thread refusals. NOT covered: a held token or the "
		"registry destroyed off the game thread (unsafe experiment), quarantine, drift and re-entry (source-checked only)."));
	return true;
}

#endif // WITH_DEV_AUTOMATION_TESTS
