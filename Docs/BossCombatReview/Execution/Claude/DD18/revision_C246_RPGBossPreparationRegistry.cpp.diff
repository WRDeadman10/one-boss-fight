+	/** After the facade (which loads assets) the binding is resolved through the retained WEAK reference before any live field is read; the saved raw pointer is never dereferenced again. */
+	bool BindingStillAdmissible(const TWeakObjectPtr<const ARPGEncounterBinding>& Ref, const UWorld* World, const FGuid& OriginalEncounter, FString& Why)
+	{
+		const ARPGEncounterBinding* Live = Ref.Get();
+		if (!Live)
+		{
+			Why = TEXT("the retained binding no longer resolves (destroyed or collected)");
+			return false;
+		}
+		if (!IsValid(Live) || Live->IsActorBeingDestroyed())
+		{
+			Why = TEXT("the binding is being destroyed or is no longer valid");
+			return false;
+		}
+		if (Live->GetWorld() != World)
+		{
+			Why = TEXT("the binding is no longer in the registry's world");
+			return false;
+		}
+		if (Live->HasActorBegunPlay() || Live->IsActorBeginningPlay())
+		{
+			Why = TEXT("the binding began or is beginning play");
+			return false;
+		}
+		if (Live->EncounterInstance != OriginalEncounter)
+		{
+			Why = TEXT("the binding's encounter GUID is no longer the attempted one");
+			return false;
+		}
+		return true;
+	}
