diff --git a/Source/OneBossFight/Player/RPGBossWorldPreparation.h b/Source/OneBossFight/Player/RPGBossWorldPreparation.h
new file mode 100644
index 0000000..3ab27cf
--- /dev/null
+++ b/Source/OneBossFight/Player/RPGBossWorldPreparation.h
@@ -0,0 +1,47 @@
+// Copyright One Boss Fight. All Rights Reserved.
+
+#pragma once
+
+#include "CoreMinimal.h"
+#include "Player/RPGBossHydrationPreparation.h"
+#include "Player/RPGBossWorldInputCompiler.h"
+
+class ARPGEncounterBinding;
+class UWorld;
+
+/**
+ * World-bound unregistered PREPARATION facade (DD18 part A): the explicitly called function that composes the two accepted stages for a placed encounter: RPGBossWorldInputCompiler::CompileWorldInput (the content epoch
+ * comes ONLY from the world's own game instance through RPGCombatRegistry::ForWorld, one production config per explicit definition, whole-batch preflight) and RPGBossHydrationPreparation::PrepareBatch (five owned
+ * unregistered native components per boss-core member). The function accepts NO caller epoch, config, plan or callback, has no manufactured fallback and repeats NO validator: every input and layer diagnostic is the nested
+ * diagnostic of the stage that produced it (WorldInput.* for the input compiler and its nested production and preflight layers, Preflight.* and Preparation.* for the preparation, WorldPrep.* only for what this facade
+ * itself checks). Nothing in the project calls it: no spawn, startup or level hook, no UCLASS, no subsystem, no process-static world map.
+ *
+ * Game thread only (refused before any UObject is touched otherwise). The result is returned by value and is move-only: the prepared artifact exists ONLY on full success, so no stale out parameter can hold a half
+ * result. The identities are checked around BOTH stages by one facade-local checkpoint (the input compiler's own checkpoints are private to it and are not duplicated here): the world valid and the same, the world's game
+ * instance valid and the same, the published epoch pointer the very lease the input holds, the binding resolved through a retained weak reference (valid, not being destroyed, in the world, not begun or beginning, same
+ * GUID), the binding's participants unchanged and matching the compiled input request by request, and every member actor and definition still valid, in the world and not begun. A failed check (WorldPrep.Drift) after
+ * the preparation aborts precisely the components THIS call allocated, appends the cleanup errors and returns no artifact (a cleanup that leaves components in place is reported as WorldPrep.ContractViolation: this facade reserves nothing, so a caller that
+ * needs such an encounter to stay blocked uses the registry, which quarantines it); a failed check before the preparation allocates nothing. An earlier independent artifact is
+ * never touched.
+ *
+ * Inherited limits, not removed: the components keep the native default bAutoRegister (an engine path that registers all owner components would register them), a destroyed uncollected component name is replaced in place
+ * when the same name is created again (no reference to a destroyed component may be kept), the manifest hash and the manifest rows inside the definitions are caller-supplied membership data (the epoch comes from the
+ * game instance, the manifest does not), and the artifact must be released on the game thread. It reserves nothing by itself (see the preparation registry) and is not a registration, a participant, a context binding,
+ * a Ready state, an activation, a legacy disposition or a target or reset operation: it has none of those operations. Epoch, GI or binding changes DURING a stage cannot be provoked without a callback, a cvar or an
+ * injection framework and are covered only by the checkpoints of the stages and of this facade: source claims, not executed failures.
+ */
+struct FRPGWorldPreparationResult
+{
+	/** Empty exactly on success. Nested diagnostics are carried unchanged. */
+	TArray<FString> Errors;
+	/** Set ONLY when Errors is empty: the uniquely owned prepared artifact (unregistered, never begun). */
+	TUniquePtr<FRPGPreparedBatch> Batch;
+
+	bool Succeeded() const { return Errors.IsEmpty() && Batch.IsValid(); }
+};
+
+namespace RPGBossWorldPreparation
+{
+	/** Compiles the world input and prepares the whole batch (see above). Game thread only. */
+	ONEBOSSFIGHT_API FRPGWorldPreparationResult PrepareWorldBatch(UWorld* ExpectedWorld, const ARPGEncounterBinding* Binding, const TArray<RPGBossWorldInputCompiler::FSelection>& Selections, const FString& ManifestHash);
+}
diff --git a/Source/OneBossFight/Player/RPGBossWorldPreparation.cpp b/Source/OneBossFight/Player/RPGBossWorldPreparation.cpp
new file mode 100644
index 0000000..9b5fe3c
--- /dev/null
+++ b/Source/OneBossFight/Player/RPGBossWorldPreparation.cpp
@@ -0,0 +1,198 @@
+// Copyright One Boss Fight. All Rights Reserved.
+
+#include "Player/RPGBossWorldPreparation.h"
+
+#include "Engine/GameInstance.h"
+#include "Engine/World.h"
+#include "GameFramework/Actor.h"
+#include "Player/RPGCombatCatalog.h"
+#include "Player/RPGEncounterBinding.h"
+
+namespace
+{
+	/** The identities this facade holds around both stages. Captured before the input stage (from the live binding), completed from the compiled input, checked after each stage. */
+	struct FIdentity
+	{
+		struct FMember
+		{
+			TWeakObjectPtr<AActor> Actor;
+			FName Slot;
+			FName TargetSlot;
+			TWeakObjectPtr<URPGBossDefinition> Definition;
+		};
+
+		TWeakObjectPtr<UWorld> World;
+		TWeakObjectPtr<UGameInstance> GameInstance;
+		TWeakObjectPtr<const ARPGEncounterBinding> Binding;
+		FGuid Encounter;
+		TArray<FMember> Members;
+		/** The very epoch lease the compiled input holds (set by Complete). */
+		TSharedPtr<const RPGCombatRegistry::FEpoch> Content;
+		bool bCaptured = false;
+		bool bCompleted = false;
+	};
+
+	/** Reads the live binding. False when the world or the binding cannot be read (the input stage then reports the real reason; a success of that stage after a failed capture is drift). */
+	bool Capture(UWorld* World, const ARPGEncounterBinding* Binding, FIdentity& Out)
+	{
+		if (!World || !IsValid(World) || !Binding || !IsValid(Binding))
+		{
+			return false;
+		}
+		Out.World = World;
+		Out.GameInstance = World->GetGameInstance();
+		Out.Binding = Binding;
+		Out.Encounter = Binding->EncounterInstance;
+		for (const FRPGPlacedParticipantBinding& Participant : Binding->Participants)
+		{
+			FIdentity::FMember Member;
+			Member.Actor = Participant.Actor.Get();
+			Member.Slot = Participant.Slot;
+			Member.TargetSlot = Participant.TargetSlot;
+			Member.Definition = Participant.Definition.Get();
+			Out.Members.Add(Member);
+		}
+		Out.bCaptured = true;
+		return true;
+	}
+
+	/** Completes the identity from the compiled input and requires that the input is exactly the captured encounter: world, GUID, one request per participant with the same actor, slot and target. */
+	bool Complete(FIdentity& Identity, UWorld* World, const FRPGHydrationPreflightInput& Input, FString& Why)
+	{
+		if (!Identity.bCaptured)
+		{
+			Why = TEXT("the world and binding identities could not be captured before the input stage");
+			return false;
+		}
+		if (Input.ExpectedWorld.Get() != World || Input.EncounterInstance != Identity.Encounter || !Input.ExpectedContent.IsValid() || Input.Requests.Num() != Identity.Members.Num())
+		{
+			Why = TEXT("the compiled input is not the captured world, encounter GUID and participant count");
+			return false;
+		}
+		for (int32 Index = 0; Index < Input.Requests.Num(); ++Index)
+		{
+			const FRPGHydrationPreflightRequest& Request = Input.Requests[Index];
+			const FIdentity::FMember& Member = Identity.Members[Index];
+			if (Request.Actor.Get() != Member.Actor.Get() || Request.Slot != Member.Slot || Request.TargetSlot != Member.TargetSlot)
+			{
+				Why = FString::Printf(TEXT("request #%d of the compiled input is not participant #%d of the captured binding"), Index, Index);
+				return false;
+			}
+		}
+		Identity.Content = Input.ExpectedContent;
+		Identity.bCompleted = true;
+		return true;
+	}
+
+	/** The checkpoint, run after the input stage and after the preparation stage. */
+	bool Holds(UWorld* World, const FIdentity& Identity, FString& Why)
+	{
+		if (!Identity.bCompleted || !Identity.World.IsValid() || Identity.World.Get() != World || !IsValid(World))
+		{
+			Why = TEXT("the world changed or is no longer valid");
+			return false;
+		}
+		UGameInstance* GameInstance = World->GetGameInstance();
+		if (!GameInstance || GameInstance != Identity.GameInstance.Get() || !IsValid(GameInstance))
+		{
+			Why = TEXT("the world's game instance changed or is no longer valid");
+			return false;
+		}
+		if (RPGCombatRegistry::ForWorld(World).Get() != Identity.Content.Get())
+		{
+			Why = TEXT("the published epoch is no longer the very lease the compiled input holds");
+			return false;
+		}
+		const ARPGEncounterBinding* Live = Identity.Binding.Get();
+		if (!Live || !IsValid(Live) || Live->IsActorBeingDestroyed() || Live->GetWorld() != World || Live->HasActorBegunPlay() || Live->IsActorBeginningPlay())
+		{
+			Why = TEXT("the encounter binding is no longer valid, is being destroyed, is not in the world or began play");
+			return false;
+		}
+		if (Live->EncounterInstance != Identity.Encounter || Live->Participants.Num() != Identity.Members.Num())
+		{
+			Why = TEXT("the encounter GUID or the participant count of the binding changed");
+			return false;
+		}
+		for (int32 Index = 0; Index < Identity.Members.Num(); ++Index)
+		{
+			const FRPGPlacedParticipantBinding& Participant = Live->Participants[Index];
+			const FIdentity::FMember& Member = Identity.Members[Index];
+			if (Participant.Slot != Member.Slot || Participant.TargetSlot != Member.TargetSlot || Participant.Actor.Get() != Member.Actor.Get() || Participant.Definition.Get() != Member.Definition.Get())
+			{
+				Why = FString::Printf(TEXT("participant #%d of the binding changed"), Index);
+				return false;
+			}
+			const AActor* Actor = Member.Actor.Get();
+			if (!Actor || !IsValid(Actor) || Actor->IsActorBeingDestroyed() || Actor->GetWorld() != World || Actor->HasActorBegunPlay() || Actor->IsActorBeginningPlay() || !Member.Definition.Get() || !IsValid(Member.Definition.Get()))
+			{
+				Why = FString::Printf(TEXT("the actor or the definition of participant #%d is no longer valid, in the world and not begun"), Index);
+				return false;
+			}
+		}
+		return true;
+	}
+}
+
+namespace RPGBossWorldPreparation
+{
+	FRPGWorldPreparationResult PrepareWorldBatch(UWorld* ExpectedWorld, const ARPGEncounterBinding* Binding, const TArray<RPGBossWorldInputCompiler::FSelection>& Selections, const FString& ManifestHash)
+	{
+		FRPGWorldPreparationResult Result;
+		// Before any UObject (the world, the binding) is touched.
+		if (!IsInGameThread())
+		{
+			Result.Errors.Add(TEXT("WorldPrep.NotGameThread: a world batch is prepared on the game thread only (nothing was touched)"));
+			return Result;
+		}
+
+		FIdentity Identity;
+		Capture(ExpectedWorld, Binding, Identity);
+
+		// Stage 1: the world-bound input (the epoch comes only from the world's own game instance). Its diagnostics, nested layers included, are carried unchanged.
+		FRPGHydrationPreflightInput Input;
+		const FRPGHydrationResult Compiled = RPGBossWorldInputCompiler::CompileWorldInput(ExpectedWorld, Binding, Selections, ManifestHash, Input);
+		if (!Compiled.IsReady())
+		{
+			Result.Errors = Compiled.Errors;
+			return Result; // nothing was allocated: the input stage creates no component
+		}
+		FString Why;
+		if (!Complete(Identity, ExpectedWorld, Input, Why) || !Holds(ExpectedWorld, Identity, Why))
+		{
+			Result.Errors.Add(FString::Printf(TEXT("WorldPrep.Drift[after the input stage]: %s (nothing was allocated)"), *Why));
+			return Result;
+		}
+
+		// Stage 2: the owned unregistered preparation of the whole batch. Its diagnostics are carried unchanged.
+		FRPGPreparationResult Prepared = RPGBossHydrationPreparation::PrepareBatch(Input);
+		if (!Prepared.Succeeded())
+		{
+			Result.Errors = Prepared.Errors; // PrepareBatch already destroyed everything it allocated
+			if (Result.Errors.IsEmpty())
+			{
+				Result.Errors.Add(TEXT("WorldPrep.PreparationRejected: the preparation returned no artifact and no error"));
+			}
+			return Result;
+		}
+
+		// The same checkpoint after the preparation. A failure aborts precisely the components this call allocated.
+		if (!Holds(ExpectedWorld, Identity, Why))
+		{
+			Result.Errors.Add(FString::Printf(TEXT("WorldPrep.Drift[after the preparation stage]: %s (this call's components were aborted)"), *Why));
+			const FRPGPreparationAbortReport Cleanup = Prepared.Batch->Abort();
+			for (const FString& CleanupError : Cleanup.Errors)
+			{
+				Result.Errors.Add(FString::Printf(TEXT("WorldPrep.CleanupAfterDrift: %s"), *CleanupError));
+			}
+			if (Cleanup.ContractViolations > 0 || Cleanup.bRefused)
+			{
+				Result.Errors.Add(FString::Printf(TEXT("WorldPrep.ContractViolation: the cleanup after drift left %d component(s) in place (violations) or was refused"), Cleanup.ContractViolations));
+			}
+			return Result; // the artifact is destroyed with Prepared; none escapes
+		}
+
+		Result.Batch = MoveTemp(Prepared.Batch);
+		return Result;
+	}
+}
diff --git a/Source/OneBossFight/Player/RPGBossPreparationRegistry.h b/Source/OneBossFight/Player/RPGBossPreparationRegistry.h
new file mode 100644
index 0000000..70c21af
--- /dev/null
+++ b/Source/OneBossFight/Player/RPGBossPreparationRegistry.h
@@ -0,0 +1,163 @@
+// Copyright One Boss Fight. All Rights Reserved.
+
+#pragma once
+
+#include "CoreMinimal.h"
+#include "Player/RPGBossHydrationPreparation.h"
+#include "Player/RPGBossWorldInputCompiler.h"
+#include "Templates/SharedPointer.h"
+
+class ARPGEncounterBinding;
+class FRPGBossPreparationRegistry;
+class UWorld;
+struct FRPGPreparationRegistryState;
+
+/**
+ * Explicit, registry-scoped RESERVATION and lifetime of prepared encounters (DD18 part B). A FRPGBossPreparationRegistry is an explicitly created, non-copyable, non-movable object owned by whoever creates it (a test, a
+ * future coordinator): there is no global registry, no subsystem, no process-static map and no automatic hook, and nothing here calls it. It is bound to ONE world and to the game thread.
+ *
+ * TryPrepareAndReserve composes RPGBossWorldPreparation::PrepareWorldBatch (the world-bound input compiler plus the owned unregistered preparation) with a reservation: the registry takes ownership of the prepared artifact
+ * and returns a move-only lease token. Conflicts are checked BEFORE any consumer is allocated: a duplicate encounter GUID, or any actor (boss-core or target-only, every role) already reserved by this registry, is
+ * refused. Two different, disjoint encounters coexist; identical slot strings across different encounters are legal; one batch may hold two bosses and a target. Registry entries (GUID and actors) are published ONLY after the
+ * whole batch compiled, was prepared and passed the facade's final identity checks; any failure leaves every earlier reservation and artifact intact and no provisional entry or allocation of this attempt. Admission of a
+ * second call while one is in progress on the same registry is refused (no caller callback exists, so this guards only a native re-entry, for example from an asset load).
+ *
+ * Tokens carry the registry identity (a GUID), a unique serial that is never reused, and the encounter GUID, and they hold only a WEAK reference to the registry's private shared state: a token that outlives the registry is
+ * safe and simply invalid. Tokens are validated by registry identity AND serial, never by encounter GUID alone: a stale, consumed, wrong-registry or repeated release can neither destroy a replacement reservation nor
+ * anything else. Release (explicit or by destroying the token on the game thread) aborts exactly its own unregistered artifact and frees the GUID and actor entries ONLY after a clean cleanup. A cleanup that is not clean
+ * (a component somebody registered, began or re-owned: DD15's contract violation) leaves a QUARANTINED reservation with diagnostics: its GUID and actors stay reserved, admission is not silently reopened and no
+ * rollback, unregistration, repair or deletion is attempted or claimed. A cleanup failure DURING admission (the identity checks after the preparation failed and the abort left components in place) quarantines the encounter the
+ * same way. Destroying the registry closes admission, aborts every owned artifact once (on the game thread; an abort that is not clean at that point is only logged, nothing is rolled back) and invalidates every surviving token.
+ *
+ * Threads: every operation is game-thread only: mutations are refused WITHOUT touching any UObject otherwise (a violation result) and the read accessors return neutral values (0, empty, not held, closed) off the game thread. Destroying a held token or the registry off the game thread is a contract violation that is flagged
+ * (ensure) and performs no UObject cleanup there: a held token destroyed off-thread leaves its reservation in the registry until the registry is destroyed on the game thread; the registry destroyed off-thread only closes
+ * admission and invalidates tokens, its artifacts being destroyed by their own destructors under the DD15 contract. No worker-destructor experiment exists.
+ *
+ * What a reservation is: an INCOMPLETE, UNREGISTERED, per-registry native subset (five components per boss-core member). It is NOT a world-wide or global uniqueness claim across separately created registries (a future
+ * coordinator must own the authoritative instance), not a published combat context, not a hydrated or Ready participant, not an activation, not a complete playable bundle and gives no authority to suppress a legacy
+ * attachment. Nothing is registered. Epoch or binding drift and re-entry cannot be provoked without a callback, a cvar or an injection framework: the code checks them, the tests do not execute them.
+ */
+
+/** Why a TryPrepareAndReserve call failed (None on success). */
+enum class EReservationFailure : uint8
+{
+	None,
+	/** The inputs are invalid: world (including a world that no longer exists), binding, selections, definitions, manifest hash, content, closed registry. */
+	InvalidInput,
+	/** The encounter GUID or an actor is already reserved by this registry. */
+	Conflict,
+	/** The world, the game instance, the epoch or the binding changed. */
+	Drift,
+	/** The preparation (allocation or configuration) failed and was cleaned up. */
+	PreparationFailed,
+	/** A contract was violated: wrong thread, re-entry, or a cleanup that left something in place. */
+	ContractViolation,
+};
+
+/** What one release did. */
+struct FRPGReleaseReport
+{
+	enum class EOutcome : uint8
+	{
+		/** Released: the artifact was aborted cleanly and the reservation was freed. */
+		Released,
+		/** Refused: not on the game thread, nothing was touched. */
+		Refused,
+		/** The token holds nothing, or its serial is no longer reserved here (consumed, stale, registry gone). Nothing was touched and the stale token was cleared. */
+		Stale,
+		/** The token belongs to another registry. Nothing was touched. */
+		WrongRegistry,
+		/** The abort was not clean: the reservation is quarantined, not freed, and the token is consumed. */
+		Quarantined,
+	};
+
+	EOutcome Outcome = EOutcome::Stale;
+	TArray<FString> Errors;
+	/** What the abort of the owned artifact did (empty unless the artifact was aborted). */
+	FRPGPreparationAbortReport Abort;
+
+	bool IsReleased() const { return Outcome == EOutcome::Released; }
+};
+
+/** The move-only lease of one reservation. Destroying it on the game thread releases the reservation. */
+class ONEBOSSFIGHT_API FRPGPreparationLeaseToken
+{
+public:
+	FRPGPreparationLeaseToken() = default;
+	~FRPGPreparationLeaseToken();
+
+	FRPGPreparationLeaseToken(const FRPGPreparationLeaseToken&) = delete;
+	FRPGPreparationLeaseToken& operator=(const FRPGPreparationLeaseToken&) = delete;
+	FRPGPreparationLeaseToken(FRPGPreparationLeaseToken&& Other) noexcept;
+	FRPGPreparationLeaseToken& operator=(FRPGPreparationLeaseToken&& Other) noexcept;
+
+	/** True while the registry is alive and still reserves this token's serial as an active reservation. */
+	bool IsHeld() const;
+
+	uint64 GetSerial() const { return Serial; }
+	const FGuid& GetRegistryId() const { return RegistryId; }
+	const FGuid& GetEncounter() const { return Encounter; }
+
+	/** Releases through the token's own registry (same validation and effect as FRPGBossPreparationRegistry::Release: Released, Quarantined and Stale consume the token, Refused leaves it). */
+	FRPGReleaseReport Release();
+
+#if WITH_DEV_AUTOMATION_TESTS
+	/** TEST ONLY, dev automation builds only: a token carrying the given registry identity, serial and encounter, to prove that validation is by registry and SERIAL and never by GUID alone. It is not an author control. */
+	static FRPGPreparationLeaseToken ForgeForTest(const FRPGBossPreparationRegistry& Registry, uint64 ForgedSerial, const FGuid& ForgedEncounter);
+#endif
+
+private:
+	friend class FRPGBossPreparationRegistry;
+
+	void Clear();
+
+	TWeakPtr<FRPGPreparationRegistryState> State;
+	FGuid RegistryId;
+	FGuid Encounter;
+	uint64 Serial = 0;
+};
+
+/** The result of TryPrepareAndReserve: move-only (it holds the token). The token is held ONLY on success. */
+struct FRPGReservationResult
+{
+	TArray<FString> Errors;
+	EReservationFailure Failure = EReservationFailure::None;
+	FRPGPreparationLeaseToken Token;
+
+	bool Succeeded() const { return Errors.IsEmpty() && Failure == EReservationFailure::None && Token.IsHeld(); }
+};
+
+/** The explicit per-world registry (see above). Game thread only. */
+class ONEBOSSFIGHT_API FRPGBossPreparationRegistry
+{
+public:
+	/** Bound to one world. */
+	explicit FRPGBossPreparationRegistry(UWorld* InWorld);
+	~FRPGBossPreparationRegistry();
+
+	FRPGBossPreparationRegistry(const FRPGBossPreparationRegistry&) = delete;
+	FRPGBossPreparationRegistry& operator=(const FRPGBossPreparationRegistry&) = delete;
+	FRPGBossPreparationRegistry(FRPGBossPreparationRegistry&&) = delete;
+	FRPGBossPreparationRegistry& operator=(FRPGBossPreparationRegistry&&) = delete;
+
+	/** Conflict pre-check, whole-batch preparation, final identity checks, then publication of the reservation. Game thread only. */
+	FRPGReservationResult TryPrepareAndReserve(const ARPGEncounterBinding* Binding, const TArray<RPGBossWorldInputCompiler::FSelection>& Selections, const FString& ManifestHash);
+
+	/** Releases the reservation of the token (validated by registry identity and serial). On Released, Quarantined and Stale the token is consumed (a stale token is worthless); on Refused and WrongRegistry it is left as it was. Game thread only. */
+	FRPGReleaseReport Release(FRPGPreparationLeaseToken& Token);
+
+	const FGuid& GetRegistryId() const;
+	bool IsAdmissionClosed() const;
+	/** Active (releasable) reservations. */
+	int32 GetActiveReservationCount() const;
+	int32 GetQuarantinedCount() const;
+	/** The encounter GUIDs reserved by active or quarantined reservations, in admission order. */
+	TArray<FGuid> GetReservedEncounters() const;
+	/** The diagnostics of every quarantined reservation. */
+	TArray<FString> GetQuarantineDiagnostics() const;
+
+private:
+	friend class FRPGPreparationLeaseToken;
+
+	TSharedRef<FRPGPreparationRegistryState> State;
+};
diff --git a/Source/OneBossFight/Player/RPGBossPreparationRegistry.cpp b/Source/OneBossFight/Player/RPGBossPreparationRegistry.cpp
new file mode 100644
index 0000000..e4c2f6d
--- /dev/null
+++ b/Source/OneBossFight/Player/RPGBossPreparationRegistry.cpp
@@ -0,0 +1,567 @@
+// Copyright One Boss Fight. All Rights Reserved.
+
+#include "Player/RPGBossPreparationRegistry.h"
+
+#include "Engine/World.h"
+#include "GameFramework/Actor.h"
+#include "Player/RPGBossWorldPreparation.h"
+#include "Player/RPGEncounterBinding.h"
+
+DEFINE_LOG_CATEGORY_STATIC(LogRPGPreparationRegistry, Log, All);
+
+/** The private shared state of one registry. Tokens hold it only weakly: when the registry dies the state dies with it and every token becomes invalid. */
+struct FRPGPreparationRegistryState
+{
+	enum class EEntryState : uint8
+	{
+		Active,
+		Quarantined,
+	};
+
+	struct FEntry
+	{
+		uint64 Serial = 0;
+		FGuid Encounter;
+		/** Every actor of the batch (all roles), weakly: a destroyed actor never aliases a new one. */
+		TArray<TWeakObjectPtr<AActor>> Actors;
+		/** The owned artifact; reset once it was aborted. */
+		TUniquePtr<FRPGPreparedBatch> Batch;
+		EEntryState State = EEntryState::Active;
+		TArray<FString> Diagnostics;
+	};
+
+	FGuid RegistryId = FGuid::NewGuid();
+	TWeakObjectPtr<UWorld> World;
+	bool bClosed = false;
+	bool bAdmitting = false;
+	/** Serials start at 1 and are never reused. */
+	uint64 NextSerial = 1;
+	TArray<FEntry> Entries;
+
+	int32 FindSerial(uint64 Serial) const
+	{
+		return Entries.IndexOfByPredicate([Serial](const FEntry& Entry) { return Entry.Serial == Serial; });
+	}
+};
+
+namespace
+{
+	/** The failure family of a set of nested diagnostics: contract violation first, then drift, then preparation, else the inputs. */
+	EReservationFailure Classify(const TArray<FString>& Errors)
+	{
+		bool bViolation = false;
+		bool bDrift = false;
+		bool bPreparation = false;
+		for (const FString& Error : Errors)
+		{
+			if (Error.StartsWith(TEXT("Reservation.ContractViolation")) || Error.StartsWith(TEXT("WorldPrep.ContractViolation")) || Error.StartsWith(TEXT("Preparation.ContractViolation")) || Error.StartsWith(TEXT("WorldPrep.NotGameThread")))
+			{
+				bViolation = true;
+			}
+			else if (Error.StartsWith(TEXT("WorldPrep.Drift")) || Error.StartsWith(TEXT("WorldInput.ContentDrift")) || Error.StartsWith(TEXT("WorldInput.BindingDrift")))
+			{
+				bDrift = true;
+			}
+			else if (Error.StartsWith(TEXT("Preparation.")) || Error.StartsWith(TEXT("WorldPrep.PreparationRejected")) || Error.StartsWith(TEXT("WorldPrep.CleanupAfterDrift")))
+			{
+				bPreparation = true;
+			}
+		}
+		return bViolation ? EReservationFailure::ContractViolation : bDrift ? EReservationFailure::Drift : bPreparation ? EReservationFailure::PreparationFailed : EReservationFailure::InvalidInput;
+	}
+
+	/** Releases the active entry of a serial: aborts exactly its artifact and frees the entry only after a clean cleanup; otherwise the entry is quarantined and nothing is reopened. */
+	FRPGReleaseReport ReleaseSerial(FRPGPreparationRegistryState& State, uint64 Serial)
+	{
+		FRPGReleaseReport Report;
+		const int32 Index = State.FindSerial(Serial);
+		if (Index == INDEX_NONE)
+		{
+			Report.Outcome = FRPGReleaseReport::EOutcome::Stale;
+			Report.Errors.Add(FString::Printf(TEXT("Reservation.TokenStale: serial %llu is not reserved here"), Serial));
+			return Report;
+		}
+		FRPGPreparationRegistryState::FEntry& Entry = State.Entries[Index];
+		if (Entry.State != FRPGPreparationRegistryState::EEntryState::Active || !Entry.Batch.IsValid())
+		{
+			Report.Outcome = FRPGReleaseReport::EOutcome::Stale;
+			Report.Errors.Add(FString::Printf(TEXT("Reservation.TokenStale: serial %llu is quarantined or already released; nothing was touched"), Serial));
+			return Report;
+		}
+		Report.Abort = Entry.Batch->Abort();
+		if (Report.Abort.IsClean() && Report.Abort.ContractViolations == 0)
+		{
+			State.Entries.RemoveAt(Index); // the indices are freed only now, after the clean cleanup
+			Report.Outcome = FRPGReleaseReport::EOutcome::Released;
+			return Report;
+		}
+		// Not clean: quarantine. The GUID and the actors stay reserved, no repair or deletion is attempted, no rollback is claimed.
+		Entry.State = FRPGPreparationRegistryState::EEntryState::Quarantined;
+		Entry.Diagnostics = Report.Abort.Errors;
+		Entry.Diagnostics.Add(FString::Printf(TEXT("Reservation.Quarantined[serial=%llu][encounter=%s]: the cleanup left %d component(s) in place (violations); the reservation stays, nothing was rolled back"), Serial, *Entry.Encounter.ToString(), Report.Abort.ContractViolations));
+		Entry.Batch.Reset();
+		Report.Outcome = FRPGReleaseReport::EOutcome::Quarantined;
+		Report.Errors = Entry.Diagnostics;
+		UE_LOG(LogRPGPreparationRegistry, Error, TEXT("reservation %llu of encounter %s is quarantined: %s"), Serial, *Entry.Encounter.ToString(), *FString::Join(Report.Abort.Errors, TEXT(" | ")));
+		return Report;
+	}
+
+	/** Publishes a QUARANTINED reservation (it has no artifact: a cleanup left components in place) so that its GUID and its actors stay reserved and admission is not silently reopened. Nothing is rolled back, repaired or deleted. */
+	void PublishQuarantine(FRPGPreparationRegistryState& State, const FGuid& Encounter, const TArray<TWeakObjectPtr<AActor>>& Actors, const TArray<FString>& Errors)
+	{
+		FRPGPreparationRegistryState::FEntry Entry;
+		Entry.Serial = State.NextSerial++;
+		Entry.Encounter = Encounter;
+		Entry.Actors = Actors;
+		Entry.State = FRPGPreparationRegistryState::EEntryState::Quarantined;
+		Entry.Diagnostics = Errors;
+		Entry.Diagnostics.Add(FString::Printf(TEXT("Reservation.Quarantined[serial=%llu][encounter=%s]: a cleanup during admission left components in place; the encounter stays reserved, nothing was rolled back"), Entry.Serial, *Encounter.ToString()));
+		UE_LOG(LogRPGPreparationRegistry, Error, TEXT("encounter %s is quarantined (serial %llu): %s"), *Encounter.ToString(), Entry.Serial, *FString::Join(Errors, TEXT(" | ")));
+		State.Entries.Add(MoveTemp(Entry));
+	}
+
+	/** After the facade (which loads assets) the binding is resolved through the retained WEAK reference before any live field is read; the saved raw pointer is never dereferenced again. */
+	bool BindingStillAdmissible(const TWeakObjectPtr<const ARPGEncounterBinding>& Ref, const UWorld* World, const FGuid& OriginalEncounter, FString& Why)
+	{
+		const ARPGEncounterBinding* Live = Ref.Get();
+		if (!Live)
+		{
+			Why = TEXT("the retained binding no longer resolves (destroyed or collected)");
+			return false;
+		}
+		if (!IsValid(Live) || Live->IsActorBeingDestroyed())
+		{
+			Why = TEXT("the binding is being destroyed or is no longer valid");
+			return false;
+		}
+		if (Live->GetWorld() != World)
+		{
+			Why = TEXT("the binding is no longer in the registry's world");
+			return false;
+		}
+		if (Live->HasActorBegunPlay() || Live->IsActorBeginningPlay())
+		{
+			Why = TEXT("the binding began or is beginning play");
+			return false;
+		}
+		if (Live->EncounterInstance != OriginalEncounter)
+		{
+			Why = TEXT("the binding's encounter GUID is no longer the attempted one");
+			return false;
+		}
+		return true;
+	}
+
+	/** RAII guard of the admission flag. */
+	struct FAdmissionScope
+	{
+		explicit FAdmissionScope(FRPGPreparationRegistryState& InState) : State(InState) { State.bAdmitting = true; }
+		~FAdmissionScope() { State.bAdmitting = false; }
+		FAdmissionScope(const FAdmissionScope&) = delete;
+		FAdmissionScope& operator=(const FAdmissionScope&) = delete;
+		FRPGPreparationRegistryState& State;
+	};
+}
+
+// ---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
+// Lease token
+
+FRPGPreparationLeaseToken::~FRPGPreparationLeaseToken()
+{
+	if (Serial == 0 || !State.IsValid())
+	{
+		return; // nothing held, or the registry is already gone (nothing to release, nothing to flag)
+	}
+	if (!IsInGameThread())
+	{
+		// A held token destroyed off the game thread: flagged, no UObject cleanup here. The reservation stays in the registry until the registry is destroyed on the game thread.
+		ensureMsgf(false, TEXT("a held preparation lease token was destroyed off the game thread: its reservation stays until the registry is destroyed (contract violation)"));
+		return;
+	}
+	Release();
+}
+
+FRPGPreparationLeaseToken::FRPGPreparationLeaseToken(FRPGPreparationLeaseToken&& Other) noexcept
+	: State(MoveTemp(Other.State))
+	, RegistryId(Other.RegistryId)
+	, Encounter(Other.Encounter)
+	, Serial(Other.Serial)
+{
+	Other.Clear();
+}
+
+FRPGPreparationLeaseToken& FRPGPreparationLeaseToken::operator=(FRPGPreparationLeaseToken&& Other) noexcept
+{
+	if (this != &Other)
+	{
+		// The token being replaced is released first (game thread) like a destroyed token.
+		if (Serial != 0 && State.IsValid())
+		{
+			if (IsInGameThread())
+			{
+				Release();
+			}
+			else
+			{
+				ensureMsgf(false, TEXT("a held preparation lease token was replaced off the game thread: its reservation stays until the registry is destroyed (contract violation)"));
+			}
+		}
+		State = MoveTemp(Other.State);
+		RegistryId = Other.RegistryId;
+		Encounter = Other.Encounter;
+		Serial = Other.Serial;
+		Other.Clear();
+	}
+	return *this;
+}
+
+void FRPGPreparationLeaseToken::Clear()
+{
+	State.Reset();
+	RegistryId.Invalidate();
+	Encounter.Invalidate();
+	Serial = 0;
+}
+
+bool FRPGPreparationLeaseToken::IsHeld() const
+{
+	if (Serial == 0 || !IsInGameThread())
+	{
+		return false; // reads are game-thread only
+	}
+	const TSharedPtr<FRPGPreparationRegistryState> Pinned = State.Pin();
+	if (!Pinned.IsValid() || Pinned->bClosed || Pinned->RegistryId != RegistryId)
+	{
+		return false;
+	}
+	const int32 Index = Pinned->FindSerial(Serial);
+	return Index != INDEX_NONE && Pinned->Entries[Index].State == FRPGPreparationRegistryState::EEntryState::Active && Pinned->Entries[Index].Encounter == Encounter;
+}
+
+FRPGReleaseReport FRPGPreparationLeaseToken::Release()
+{
+	FRPGReleaseReport Report;
+	if (!IsInGameThread())
+	{
+		Report.Outcome = FRPGReleaseReport::EOutcome::Refused;
+		Report.Errors.Add(TEXT("Reservation.NotGameThread: a lease is released on the game thread only (nothing was touched)"));
+		return Report;
+	}
+	const TSharedPtr<FRPGPreparationRegistryState> Pinned = State.Pin();
+	if (Serial == 0 || !Pinned.IsValid() || Pinned->bClosed || Pinned->RegistryId != RegistryId)
+	{
+		Report.Outcome = FRPGReleaseReport::EOutcome::Stale;
+		Report.Errors.Add(TEXT("Reservation.TokenStale: the token holds nothing or its registry is gone or closed (nothing was touched)"));
+		Clear();
+		return Report;
+	}
+	const int32 Index = Pinned->FindSerial(Serial);
+	if (Index == INDEX_NONE || Pinned->Entries[Index].Encounter != Encounter)
+	{
+		Report.Outcome = FRPGReleaseReport::EOutcome::Stale;
+		Report.Errors.Add(FString::Printf(TEXT("Reservation.TokenStale: serial %llu is not reserved for encounter %s here (nothing was touched)"), Serial, *Encounter.ToString()));
+		Clear();
+		return Report;
+	}
+	Report = ReleaseSerial(*Pinned, Serial);
+	Clear();
+	return Report;
+}
