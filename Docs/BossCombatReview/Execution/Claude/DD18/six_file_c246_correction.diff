+			Set.Target = Scope.SpawnCharacter(PlayerMesh, FVector(Offset + 1000.f, 0.f, 0.f));
+			if (!Set.BossOne || !Set.BossTwo || !Set.Target)
+			{
+				Test.AddError(TEXT("unsupported precondition: the native character actors of an encounter could not be spawned"));
+				Sets.Pop();
+				return nullptr;
+			}
+			const TArray<AActor*> Actors = Set.Actors();
+			for (int32 Index = 0; Index < 3; ++Index)
+			{
+				Set.Markers[Index] = NewObject<USceneComponent>(Actors[Index], TEXT("UnrelatedMarker"));
+				Set.Definitions[Index].Reset(NewObject<URPGBossDefinition>());
+				if (!Set.Markers[Index] || !Set.Definitions[Index].IsValid())
+				{
+					Test.AddError(TEXT("unsupported precondition: a marker component or a transient definition could not be created"));
+					Sets.Pop();
+					return nullptr;
+				}
+			}
+			FillDefinition(*Set.Definitions[0], FMemberValues{FString::Printf(TEXT("RegBossOne%d"), Tag), FString::Printf(TEXT("RegBossOneLook%d"), Tag), TEXT("PhaseTwo"), 0.35f, 3500.f, 73.5f, 3.25f}, BossSkeleton, BossAnimationPaths());
+			FillDefinition(*Set.Definitions[1], FMemberValues{FString::Printf(TEXT("RegBossTwo%d"), Tag), FString::Printf(TEXT("RegBossTwoLook%d"), Tag), TEXT("PhaseAlt"), 0.5f, 4100.f, 88.f, 4.5f}, BossSkeleton, BossAnimationPaths());
+			FillDefinition(*Set.Definitions[2], FMemberValues{FString::Printf(TEXT("RegTarget%d"), Tag), FString::Printf(TEXT("RegTargetLook%d"), Tag), TEXT("PhaseTwo"), 0.35f, 3500.f, 73.5f, 3.25f}, PlayerSkeleton, TargetAnimationPaths());
