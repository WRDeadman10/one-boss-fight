+IMPLEMENT_SIMPLE_AUTOMATION_TEST(FRPGPreparationRegistryAdmissionTest, "OneBossFight.Binding.PreparationRegistry.AdmissionAndConflicts",
+	EAutomationTestFlags::EditorContext | EAutomationTestFlags::ProductFilter)
+bool FRPGPreparationRegistryAdmissionTest::RunTest(const FString& Parameters)
+{
+	FMultiFixture F;
+	if (!F.Load(*this))
+	{
+		return false;
+	}
+	FEncounterSet* A = F.AddSet(*this, 0);
+	FEncounterSet* B = F.AddSet(*this, 1);
+	if (!A || !B)
+	{
+		return false;
+	}
+	FRPGBossPreparationRegistry Registry(F.Scope.World);
+	TestTrue(TEXT("a new registry is open, empty and has its own identity"), !Registry.IsAdmissionClosed() && Registry.GetActiveReservationCount() == 0 && Registry.GetQuarantinedCount() == 0 && Registry.GetRegistryId().IsValid());
+
+	// Two disjoint encounters coexist; the slot strings are identical across them (legal); each batch is two bosses and a target.
+	FRPGReservationResult ResultA = Registry.TryPrepareAndReserve(A->Binding, F.MakeSelections(), ManifestHash());
+	if (!TestTrue(FString::Printf(TEXT("encounter A is prepared and reserved (errors: %s)"), *JoinErrors(ResultA.Errors)), ResultA.Succeeded()))
+	{
+		return false;
+	}
+	FRPGReservationResult ResultB = Registry.TryPrepareAndReserve(B->Binding, F.MakeSelections(), ManifestHash());
+	if (!TestTrue(FString::Printf(TEXT("the disjoint encounter B is prepared and reserved too (errors: %s)"), *JoinErrors(ResultB.Errors)), ResultB.Succeeded()))
+	{
+		return false;
+	}
+	TestTrue(TEXT("the two encounters use identical slot strings"), A->Binding->Participants[0].Slot == B->Binding->Participants[0].Slot && A->Binding->Participants[1].Slot == B->Binding->Participants[1].Slot
+		&& A->Binding->Participants[2].Slot == B->Binding->Participants[2].Slot && A->Binding->Participants[0].Slot == FName(TEXT("BossOne")));
+	TestTrue(TEXT("two active reservations, no quarantine, both GUIDs reserved in admission order"), Registry.GetActiveReservationCount() == 2 && Registry.GetQuarantinedCount() == 0 && Registry.GetReservedEncounters() == TArray<FGuid>{A->Encounter, B->Encounter});
+	TestTrue(TEXT("the tokens carry the registry identity, distinct serials and their own encounter GUIDs, and are held"), ResultA.Token.IsHeld() && ResultB.Token.IsHeld() && ResultA.Token.GetRegistryId() == Registry.GetRegistryId()
+		&& ResultB.Token.GetRegistryId() == Registry.GetRegistryId() && ResultA.Token.GetSerial() != ResultB.Token.GetSerial() && ResultA.Token.GetSerial() != 0 && ResultB.Token.GetSerial() != 0
+		&& ResultA.Token.GetEncounter() == A->Encounter && ResultB.Token.GetEncounter() == B->Encounter);
+	TestTrue(TEXT("both encounters hold ten unregistered components each (five per boss, none on the target) and the unrelated markers are untouched"), IsFullyPrepared(*A) && IsFullyPrepared(*B) && MarkersIntact(*A) && MarkersIntact(*B));
+
+	// A duplicate encounter GUID with fully disjoint actors: refused before anything is allocated for the new actors.
+	FEncounterSet* C = F.AddSet(*this, 2);
+	FEncounterSet* D = F.AddSet(*this, 3);
+	FEncounterSet* E = F.AddSet(*this, 4);
+	FEncounterSet* G = F.AddSet(*this, 5);
+	if (!C || !D || !E || !G)
+	{
+		return false;
+	}
+	C->Binding->EncounterInstance = A->Encounter;
+	ExpectRefused(*this, F, Registry, TEXT("a duplicate encounter GUID with disjoint actors"), C->Binding, EReservationFailure::Conflict, TEXT("Reservation.DuplicateEncounter"), TEXT("[encounter="));
+	TestTrue(TEXT("a duplicate GUID: the disjoint actors of the refused encounter hold no consumer and no allocated name"), HasNoConsumers(*C) && NothingAllocated(*C));
+
+	// Overlap of a TARGET-ONLY actor: encounter D's third member is encounter A's target actor.
+	{
+		TArray<FRPGPlacedParticipantBinding> Overlap = F.MakeParticipants(*D);
+		Overlap[2].Actor = A->Target;
+		Overlap[2].Definition = A->Definitions[2].Get();
+		ARPGEncounterBinding* Case = F.SpawnBinding(Overlap, FGuid::NewGuid());
+		if (TestNotNull(TEXT("a binding overlapping a reserved target actor was spawned"), Case))
+		{
+			ExpectRefused(*this, F, Registry, TEXT("a target-only actor overlap"), Case, EReservationFailure::Conflict, TEXT("Reservation.ActorConflict"), TEXT("[slot=Player]"));
+			TestTrue(TEXT("a target overlap: the other actors of the refused encounter hold no consumer and no allocated name"), NoManagedConsumer(D->BossOne) && NoManagedConsumer(D->BossTwo) && NothingAllocated(*D));
+		}
+	}
+	// Overlap of a BOSS actor: encounter E's second member is encounter B's first boss.
+	{
+		TArray<FRPGPlacedParticipantBinding> Overlap = F.MakeParticipants(*E);
+		Overlap[1].Actor = B->BossOne;
+		Overlap[1].Definition = B->Definitions[0].Get();
+		ARPGEncounterBinding* Case = F.SpawnBinding(Overlap, FGuid::NewGuid());
+		if (TestNotNull(TEXT("a binding overlapping a reserved boss actor was spawned"), Case))
+		{
+			ExpectRefused(*this, F, Registry, TEXT("a boss actor overlap"), Case, EReservationFailure::Conflict, TEXT("Reservation.ActorConflict"), TEXT("[slot=BossTwo]"));
+			TestTrue(TEXT("a boss overlap: the other actors of the refused encounter hold no consumer and no allocated name"), NoManagedConsumer(E->BossOne) && NoManagedConsumer(E->Target));
+		}
+	}
+
+	// Overlap ACROSS roles: a new target that is a reserved BOSS, and a new boss that is a reserved TARGET.
+	{
+		FEncounterSet* H = F.AddSet(*this, 6);
+		FEncounterSet* I = F.AddSet(*this, 7);
+		if (!H || !I)
+		{
+			return false;
+		}
+		TArray<FRPGPlacedParticipantBinding> TargetIsBoss = F.MakeParticipants(*H);
+		TargetIsBoss[2].Actor = A->BossOne;
+		TargetIsBoss[2].Definition = A->Definitions[0].Get();
+		ARPGEncounterBinding* CaseTargetIsBoss = F.SpawnBinding(TargetIsBoss, FGuid::NewGuid());
+		TArray<FRPGPlacedParticipantBinding> BossIsTarget = F.MakeParticipants(*I);
+		BossIsTarget[0].Actor = B->Target;
+		BossIsTarget[0].Definition = B->Definitions[2].Get();
+		ARPGEncounterBinding* CaseBossIsTarget = F.SpawnBinding(BossIsTarget, FGuid::NewGuid());
+		if (TestTrue(TEXT("the two cross-role overlap bindings were spawned"), CaseTargetIsBoss && CaseBossIsTarget))
+		{
+			ExpectRefused(*this, F, Registry, TEXT("a new target that is a reserved boss"), CaseTargetIsBoss, EReservationFailure::Conflict, TEXT("Reservation.ActorConflict"), TEXT("[slot=Player]"));
+			ExpectRefused(*this, F, Registry, TEXT("a new boss that is a reserved target"), CaseBossIsTarget, EReservationFailure::Conflict, TEXT("Reservation.ActorConflict"), TEXT("[slot=BossOne]"));
+			TestTrue(TEXT("the other actors of both refused encounters hold no consumer and no allocated name"), NoManagedConsumer(H->BossOne) && NoManagedConsumer(H->BossTwo) && NoManagedConsumer(I->Target) && NoManagedConsumer(I->BossTwo));
+		}
+		// The InvalidInput family on a LIVE registry: no binding, a bad manifest hash (the input stage names it), nothing allocated.
+		{
+			const FRPGReservationResult NoBinding = Registry.TryPrepareAndReserve(nullptr, F.MakeSelections(), ManifestHash());
+			TestTrue(FString::Printf(TEXT("no binding: InvalidInput with Reservation.InvalidBinding (got: %s)"), *JoinErrors(NoBinding.Errors)), !NoBinding.Succeeded() && NoBinding.Failure == EReservationFailure::InvalidInput
+				&& AnyErrorHasAll(NoBinding.Errors, TEXT("Reservation.InvalidBinding"), TEXT(""), TEXT("")));
+			const FString BadHash = FString::ChrN(63, TEXT('b'));
+			ExpectRefused(*this, F, Registry, TEXT("a bad manifest hash"), I->Binding, EReservationFailure::InvalidInput, TEXT("WorldInput.InvalidManifestHash"), TEXT(""), &BadHash);
+		}
+		// The binding identity on a LIVE registry: a destroyed binding, a binding that began play and a binding of ANOTHER world are refused safely (InvalidInput), nothing is allocated and the earlier reservations are untouched.
+		{
+			ARPGEncounterBinding* Destroyed = F.SpawnBinding(F.MakeParticipants(*H), FGuid::NewGuid());
+			ARPGEncounterBinding* Late = F.SpawnBinding(F.MakeParticipants(*H), FGuid::NewGuid());
+			FPlainWorld OtherWorld;
+			ARPGEncounterBinding* Foreign = OtherWorld.World ? OtherWorld.World->SpawnActor<ARPGEncounterBinding>() : nullptr;
+			if (TestTrue(TEXT("the three binding-identity cases were spawned"), Destroyed && Late && Foreign))
+			{
+				Foreign->EncounterInstance = FGuid::NewGuid();
+				Foreign->Participants = F.MakeParticipants(*H);
+				Destroyed->Destroy();
+				Late->DispatchBeginPlay();
+				TestTrue(TEXT("precondition: the late binding has begun play"), Late->HasActorBegunPlay());
+				ExpectRefused(*this, F, Registry, TEXT("a destroyed binding"), Destroyed, EReservationFailure::InvalidInput, TEXT("Reservation.InvalidBinding"), TEXT(""));
+				ExpectRefused(*this, F, Registry, TEXT("a binding that began play"), Late, EReservationFailure::InvalidInput, TEXT("WorldInput.InvalidBinding"), TEXT("began or is beginning play"));
+				ExpectRefused(*this, F, Registry, TEXT("a binding of another world"), Foreign, EReservationFailure::InvalidInput, TEXT("Reservation.InvalidBinding"), TEXT("not in this registry's world"));
+				TestTrue(TEXT("binding identity: the actors of the refused encounters hold no consumer and no allocated name, and encounters A and B are intact"), NoManagedConsumer(H->BossOne) && NoManagedConsumer(H->BossTwo) && NoManagedConsumer(H->Target)
+					&& IsFullyPrepared(*A) && IsFullyPrepared(*B) && Registry.GetActiveReservationCount() == 2);
+			}
+		}
+	}
+
+	// A failed LATE preparation (a real name collision under the later owner) preserves every earlier reservation and publishes nothing.
+	const FExpectedComponent EncounterComponent = ExpectedComponents()[2];
+	USceneComponent* Blocker = NewObject<USceneComponent>(G->BossTwo, USceneComponent::StaticClass(), FName(EncounterComponent.Name));
+	if (!TestNotNull(TEXT("the blocker was created under the later owner of encounter G"), Blocker))
+	{
+		return false;
+	}
+	TStrongObjectPtr<USceneComponent> BlockerLease(Blocker);
+	{
+		int32 BoundBefore = -1;
+		int32 ReadyBefore = -1;
+		const TArray<FActorState> Before = F.CaptureAll(BoundBefore, ReadyBefore);
+		const FRPGReservationResult Refused = Registry.TryPrepareAndReserve(G->Binding, F.MakeSelections(), ManifestHash());
+		TestFalse(TEXT("late failure: refused, no held token"), Refused.Succeeded() || Refused.Token.IsHeld());
+		TestTrue(TEXT("late failure: the preparation family"), Refused.Failure == EReservationFailure::PreparationFailed);
+		TestTrue(FString::Printf(TEXT("late failure: ONE error, the real allocation guard with the slot and the component (got: %s)"), *JoinErrors(Refused.Errors)),
+			Refused.Errors.Num() == 1 && AnyErrorHasAll(Refused.Errors, TEXT("Preparation.AllocationFailed"), TEXT("[slot=BossTwo]"), TEXT("[component=RPGBossEncounter]")));
+		int32 BoundAfter = -1;
+		int32 ReadyAfter = -1;
+		const TArray<FActorState> After = F.CaptureAll(BoundAfter, ReadyAfter);
+		TestTrue(TEXT("late failure: encounters A and B are exactly as they were (their components are the same objects) and the registry still holds exactly them"),
+			Registry.GetActiveReservationCount() == 2 && Registry.GetReservedEncounters() == TArray<FGuid>{A->Encounter, B->Encounter} && IsFullyPrepared(*A) && IsFullyPrepared(*B));
+		// Encounter G: the earlier allocations were cleaned (destroyed objects), the blocker is the very live object, nothing is reserved for it.
+		bool bGDestroyed = true;
+		for (const FExpectedComponent& Wanted : ExpectedComponents())
+		{
+			const UObject* Found = StaticFindObjectFast(UObject::StaticClass(), G->BossOne, FName(Wanted.Name));
+			bGDestroyed = bGDestroyed && Found && !IsValid(Found);
+		}
+		TestTrue(TEXT("late failure: encounter G's earlier allocations were cleaned (destroyed), the blocked name is the very live blocker and G holds no live consumer"), bGDestroyed && IsValid(Blocker)
+			&& StaticFindObjectFast(UObject::StaticClass(), G->BossTwo, FName(EncounterComponent.Name)) == Blocker && NoManagedConsumer(G->BossOne) && NoManagedConsumer(G->BossTwo) && NoManagedConsumer(G->Target));
+		// Everything except G's cleaned allocations is as before: compare the actor sets of A..F (G's actors may differ only by the destroyed objects, which are not owned components any more).
+		TestTrue(TEXT("late failure: every actor of every encounter has the same component set and flags as before"), SameStates(Before, After, BoundBefore, ReadyBefore, BoundAfter, ReadyAfter));
+	}
+	// Remove ONLY the fixture-owned blocker (renamed away first, as in the world preparation tests) and encounter G is admitted: nothing provisional was left by the failure.
+	{
+		const FName RemovedName = MakeUniqueObjectName(G->BossTwo, USceneComponent::StaticClass(), TEXT("DD18RemovedBlocker"));
+		Blocker->Rename(*RemovedName.ToString(), G->BossTwo, REN_DontCreateRedirectors | REN_NonTransactional);
+		Blocker->DestroyComponent();
+		BlockerLease.Reset();
+		Blocker = nullptr;
+		FRPGReservationResult ResultG = Registry.TryPrepareAndReserve(G->Binding, F.MakeSelections(), ManifestHash());
+		TestTrue(FString::Printf(TEXT("after only the blocker was removed encounter G is admitted (errors: %s)"), *JoinErrors(ResultG.Errors)), ResultG.Succeeded() && IsFullyPrepared(*G));
+		TestTrue(TEXT("three active reservations in admission order A, B, G"), Registry.GetActiveReservationCount() == 3 && Registry.GetReservedEncounters() == TArray<FGuid>{A->Encounter, B->Encounter, G->Encounter});
+		TestTrue(TEXT("encounters A and B were never disturbed by any refused or later admission"), IsFullyPrepared(*A) && IsFullyPrepared(*B) && ResultA.Token.IsHeld() && ResultB.Token.IsHeld());
+	}
+
+	AddInfo(TEXT("Admission on a real game-instance world: two disjoint encounters coexist with identical slot strings; a duplicate GUID, a target-only overlap and a boss overlap are refused before any allocation; a failed late preparation (real name collision) leaves the "
+		"reservations intact and publishes nothing. NOT covered: quarantine, drift and re-entry (source-checked only), a global uniqueness claim across registries."));
+	return true;
+}
