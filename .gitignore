# Visual Studio 2015 user specific files
.vs/

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app
*.ipa

# These project files can be generated by the engine
*.xcodeproj
*.xcworkspace
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb
.vsconfig

# Precompiled Assets
SourceArt/**/*.png
SourceArt/**/*.tga

# Binary Files
Binaries/*
Plugins/**/Binaries/*

# Builds
Build/*

# Whitelist PakBlacklist-<BuildConfiguration>.txt files
!Build/*/
Build/*/**
!Build/*/PakBlacklist*.txt

# Don't ignore icon files in Build
!Build/**/*.ico

# Built data for maps
*_BuiltData.uasset

# Configuration files generated by the Editor
Saved/*

# Compiled source files for the engine to use
Intermediate/*
Plugins/**/Intermediate/*

# Cache files for the editor to use
DerivedDataCache/*

# Blender backups
*.blend1
*.blend2

# Third-party store assets (Fab/Paragon): large and license-restricted. Re-download from Fab; see Documentation/ASSET_LICENSES.md.
Content/Paragon*/
# Plugin-generated script history
Content/UnrealClaude/

# Other third-party packs imported in M7 (sizes and sources in Documentation/ASSET_LICENSES.md). Re-import from the originals;
# Scripts/ImportAssetClosure.py copies only what is used.
Content/Mage/
Content/BeamPack/
Content/BloodPack/
Content/Deadly_Ruins/
Content/AdvancedARPGCombat/
Content/Free_Spells/
Content/RealisticSwordSoundEffects/
Shiva_Statue_Project/


# Dark Ruins Megascans sample content (third party, copied from the sample project; see ASSET_LICENSES.md)
Content/MS/
Content/MSPresets/
Content/CustomAssets/
Content/Smart/
Content/Materials/
Content/Blueprints/
Content/Effects/
Content/Textures/

# Third-party content: never on git (2026-10-20). Only own work is tracked: Source, Config, Scripts, Documentation,
# Content/OneBossFight (own Blueprints, levels, Blender arena meshes, materials), Import (own FBX exports).
# Footsteps, effects and starter content
Content/Essential_Foosteps_SK/
Content/Vefects/
Content/StarterContent/
# Retargets and copies made from third-party packs (Paragon Greystone and Sevarog)
Content/OneBossFight/GreystonePack/
Content/OneBossFight/SevarogPack/
Content/OneBossFight/Characters/Greystone/
Content/RMB_Cast_Grey1.uasset
# Per-user editor folders
Content/Developers/
Content/Collections/
# Drop zone for assets brought in by hand (animation packs, VFX, models, music). Everything in here stays off git.
Content/ThirdParty/
Import/ThirdParty/
# Copies of third-party pack content inside the archive of the retired C++ combat
Archive/**/Characters/Greystone/
Archive/**/*Sevarog*
Archive/
# Music brought in by hand
Import/Audio/
Content/__ExternalActors__/Free_Spells/
Content/__ExternalObjects__/Free_Spells/
*.pyc
__pycache__/
/scratch/
Docs/BossCombatReview/Execution/Codex/WP6Support/
Docs/BossCombatReview.zip
